{
  "id": "sin_wave_combo",
  "name": "正弦波组合",
  "full_name": "4575. 正弦波组合",
  "category": "数学",
  "background_theme": "无",
  "class": "EngineEffect",
  "params": {
    "layers": [
      {
        "type": "formula",
        "formula": {
          "x": "t-1",
