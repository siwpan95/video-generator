          "t_min": -1,
          "t_max": 1,
          "t_step": 0.002
        },
        "color": {
          "type": "hsv_flow",
          "hue": [
            0.5,
            0.7
          ],
          "speed": 0.1,
          "sat": 0.7,
          "val": 0.85
        },
        "line_width": 2,
        "close_threshold": 4,
        "audio": {
          "source": "rms",
          "target": "value",
          "scale": [
            0,
            1
          ],
          "smoothing": 0.85
        }
      }
    ]
  }
}