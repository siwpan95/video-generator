{
  "id": "parametric_star",
  "name": "星芒图案",
  "full_name": "4586. 星芒图案",
  "category": "公式",
  "background_theme": "无",
  "class": "EngineEffect",
  "params": {
    "layers": [
      {
        "type": "formula",
        "formula": {
          "x": "cos(t)*(1+0.3*cos(12*t))*0.7",
          "y": "sin(t)*(1+0.3*cos(12*t))*0.7",
          "t_min": 0,
          "t_max": "2*pi",
          "t_step": 0.003
        },
        "color": {
          "type": "hsv_flow",
          "hue": [
            0.5,
            0.7
          ],
          "speed": 0.1,
          "sat": 0.7,
          "val": 0.85
        },
        "line_width": 2,
        "close_threshold": 4,
        "audio": {
          "source": "rms",
          "target": "value",
          "scale": [
            0,
            1
          ],
          "smoothing": 0.85
        }
      }
    ]
  }
}