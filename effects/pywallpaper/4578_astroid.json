{
  "id": "astroid",
  "name": "星形线",
  "full_name": "4578. 星形线",
  "category": "数学",
  "background_theme": "无",
  "class": "EngineEffect",
  "params": {
    "layers": [
      {
        "type": "formula",
        "formula": {
          "x": "pow(cos(t),3)*0.8",
          "y": "pow(sin(t),3)*0.8",
          "t_min": 0,
          "t_max": "2*pi",
          "t_step": 0.005
        },
        "color": {
          "type": "hsv_flow",
          "hue": [
            0.2,
            0.4
          ],
          "speed": 0.08,
          "sat": 0.7,
          "val": 0.85
        },
        "line_width": 2,
        "close_threshold": 4,
        "audio": {
          "source": "rms",
          "target": "value",
          "scale": [
            0,
            1
          ],
          "smoothing": 0.85
        }
      }
    ]
  }
}