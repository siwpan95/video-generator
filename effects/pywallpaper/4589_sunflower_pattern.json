            0.0,
            0.15
          ],
          "speed": 0.12,
          "sat": 0.7,
          "val": 0.85
        },
        "line_width": 2,
        "close_threshold": 4,
        "audio": {
          "source": "rms",
          "target": "value",
          "scale": [
            0,
            1
          ],
          "smoothing": 0.85
        }
      }
    ]
  }
