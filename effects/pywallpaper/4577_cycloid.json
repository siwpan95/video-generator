{
  "id": "cycloid",
  "name": "摆线",
  "full_name": "4577. 摆线",
  "category": "数学",
  "background_theme": "无",
  "class": "EngineEffect",
  "params": {
    "layers": [
      {
        "type": "formula",
        "formula": {
          "x": "t-sin(t)*0.4",
          "y": "1-cos(t)*0.4",
          "t_min": 0,
          "t_max": "4*pi",
          "t_step": 0.005
        },
        "color": {
          "type": "hsv_flow",
          "hue": [
            0.7,
            0.9
          ],
          "speed": 0.1,
          "sat": 0.8,
          "val": 0.8
        },
        "line_width": 2,
        "close_threshold": 4,
        "audio": {
          "source": "rms",
          "target": "value",
          "scale": [
            0,
            1
          ],
          "smoothing": 0.85
        }
      }
    ]
  }
}