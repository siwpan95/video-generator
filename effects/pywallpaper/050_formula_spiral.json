{
  "id": "formula_spiral",
  "name": "螺旋曲线（公式）",
  "full_name": "050. 螺旋曲线（公式）",
  "category": "公式",
  "background_theme": "渐变",
  "class": "EngineEffect",
  "params": {
    "layers": [
      {
        "type": "formula",
        "formula": {
          "r": "t / (2*pi)",
          "theta": "t + time * 0.1",
          "x": "r * cos(theta)",
          "y": "r * sin(theta)",
          "t_min": 0,
          "t_max": "4*pi",
          "t_step": 0.05
        },
        "position": {"x": "50%", "y": "50%"},
        "size": {"width": "80%", "height": "80%"},
        "color": {
          "type": "hsv_flow",
          "hue": [0, 0.7],
          "speed": 0.2,
          "sat": 0.8,
          "val": 0.9
        },
        "line_width": 3,
        "audio": {
          "source": "band_energy",
          "target": "value",
          "scale": [0.0, 1.0],
          "smoothing": 0.9
        }
      }
    ]
  }
}
