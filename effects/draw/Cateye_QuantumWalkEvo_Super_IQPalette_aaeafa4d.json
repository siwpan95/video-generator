{
  "name": "迷宫之海",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.5)**2/0.04 + (y-0.5)**2/0.01 < 1) else 0"
    }
  },
  "evolution": {
    "rule": "0.5*c + 0.5*avg_n + 0.1*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*cos(2*pi*(v*p1+d1))",
    "green": "0.5+0.5*cos(2*pi*(v*p2+d2))",
    "blue": "0.5+0.5*cos(2*pi*(v*p3+d3))"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 3184,
  "postprocess": {
    "effect": "motion_trail"
  }
}