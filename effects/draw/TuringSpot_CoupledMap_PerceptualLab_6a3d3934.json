{
  "name": "TuringSpot_CoupledMap_PerceptualLab",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(14*x)*sin(14*y) + 0.3*random()"
    }
  },
  "evolution": {
    "rule": "(1 - 0.1)*c + 0.1*avg_n",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 1605,
  "postprocess": {
    "effect": "invert"
  }
}