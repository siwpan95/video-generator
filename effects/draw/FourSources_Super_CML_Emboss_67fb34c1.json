{
  "name": "FourSources_Super_CML_Emboss_vignette_200x200",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.25)**2+(y-0.25)**2<0.01 or (x-0.75)**2+(y-0.25)**2<0.01 or (x-0.25)**2+(y-0.75)**2<0.01 or (x-0.75)**2+(y-0.75)**2<0.01) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v + 0.2*sin(20*v)",
    "green": "v + 0.1*sin(20*v)",
    "blue": "v - 0.1*sin(20*v)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 51449,
  "postprocess": {
    "effect": "vignette"
  }
}