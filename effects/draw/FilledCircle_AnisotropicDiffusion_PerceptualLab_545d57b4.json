{
  "name": "彩虹之变",
  "grid": {
    "width": 80,
    "height": 80,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.5)**2 + (y-0.5)**2 < 0.16) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
