{
  "name": "分形_Mandelbrot",
  "version": "1.0",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.0"
    }
  },
  "evolution": {
    "rule": "(c*c + (x-0.5)*3.5 + (y-0.5)*2.0) % 1.0",
