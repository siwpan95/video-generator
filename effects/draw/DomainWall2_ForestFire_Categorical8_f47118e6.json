{
  "name": "DomainWall2_ForestFire_Categorical8_motion_trail_180x180",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*tanh(20*(x-0.5)) * tanh(20*(y-0.5))"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.5 and sum_n >= 0.5) else (0 if c > 0.5 else c)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(int(v*8)/8, 0, 1)",
    "green": "clip(int(v*8 + 4)/8 % 1, 0, 1)",
    "blue": "clip(1 - int(v*8)/8, 0, 1)"
  },
  "cycle": {
    "steps": 1500
  },
  "id": 20891,
  "postprocess": {
    "effect": "motion_trail"
  }
}