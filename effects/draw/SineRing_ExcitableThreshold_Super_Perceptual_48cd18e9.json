{
  "name": "量子回响",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(20*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.95)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v**abs(p1), 0, 1)",
    "green": "clip(v**abs(p2), 0, 1)",
    "blue": "clip(v**abs(p3), 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 21901,
  "postprocess": {
    "effect": "motion_trail"
  }
}