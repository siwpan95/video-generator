{
  "name": "熔岩之舞",
  "grid": {
    "width": 320,
    "height": 240,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(random()*100)*sin(random()*100)"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.5 and sum_n >= 1) else (c * 0.9)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "log(1+v*9)/log(10)",
    "green": "log(1+v*9)/log(10)",
    "blue": "log(1+v*9)/log(10)"
  },
  "cycle": {
    "steps": 500
  },
  "id": 3015,
  "postprocess": {
    "effect": "vignette"
  }
}