{
  "name": "WaveEquation2D_Slit_Super_Threshold_Super_Perceptual_edge_64x64",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "sin(2*pi*10*(x-0.3)) * exp(-((y-0.5)**2)/0.01) * (abs(x-0.3) < 0.1)"
    }
  },
  "evolution": {
    "rule": "clip(c + f1*(avg_n - c) + f2*(0.5 - abs(c - 0.5)), 0, 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v**abs(p1), 0, 1)",
    "green": "clip(v**abs(p2), 0, 1)",
    "blue": "clip(v**abs(p3), 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 30001,
  "postprocess": {
    "effect": "edge"
  }
}