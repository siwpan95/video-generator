{
  "name": "WaveEquation2D_DPProcess_SequentialBlues",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "sin(2*pi*5*sqrt((x-0.5)**2 + (y-0.5)**2)) * exp(-((x-0.5)**2 + (y-0.5)**2)/0.01)"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and random() < 0.8) or (c <= 0.5 and sum_n >= 0.5 and random() < 0.4) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "0.2 + 0.8*(1-v)",
    "green": "0.3 + 0.7*(1-v)",
    "blue": "0.5 + 0.5*v"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 2473,
  "postprocess": {
    "effect": "vignette"
  }
}