{
  "name": "RadialGradient2_AnisotropicDiffusion_RosslerPalette_edge_128x128",
  "grid": {
    "width": 128,
    "height": 128,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "abs(x-0.5) + abs(y-0.5)"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v",
    "green": "0.5+0.5*sin(4*pi*v)",
    "blue": "0.5+0.5*cos(4*pi*v)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 21456,
  "postprocess": {
    "effect": "edge"
  }
}