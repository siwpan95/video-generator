{
  "name": "对角条纹_Turing_IQ",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin((x+y)*30) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) + 0.01*sin(c*20)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*(v*0.9+0.1))",
    "green": "0.5+0.5*cos(2*pi*(v*0.7+0.3))",
    "blue": "0.5+0.5*cos(2*pi*(v*0.5+0.5))"
  },
  "id": 110
}