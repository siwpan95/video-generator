{
  "name": "黄昏之旋",
  "grid": {
    "width": 80,
    "height": 80,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.5)**2 + (y-0.5)**2 < 0.16) else 0 + 0.05*random()"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.98) + 0.01*random()",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip((v-0.5)*c1+0.5, 0, 1)",
    "green": "clip((v-0.5)*c2+0.5, 0, 1)",
    "blue": "clip((v-0.5)*c3+0.5, 0, 1)"
  },
  "cycle": {
    "steps": 100
  },
  "id": 52488,
  "postprocess": {
    "effect": "bloom"
  }
}