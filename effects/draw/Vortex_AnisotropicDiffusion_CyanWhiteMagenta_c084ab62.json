{
  "name": "光辉之舞",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "atan2(y-0.5, x-0.5) / (2*pi) % 1"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v",
    "green": "1-v",
    "blue": "0.5+0.5*v"
  },
  "cycle": {
    "steps": 300
  },
  "id": 3062,
  "postprocess": {
    "effect": "motion_trail"
  }
}