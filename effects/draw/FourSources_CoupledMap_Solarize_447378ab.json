{
  "name": "FourSources_CoupledMap_Solarize",
  "grid": {
    "width": 600,
    "height": 400,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.25)**2+(y-0.25)**2<0.01 or (x-0.75)**2+(y-0.25)**2<0.01 or (x-0.25)**2+(y-0.75)**2<0.01 or (x-0.75)**2+(y-0.75)**2<0.01) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - 0.1)*c + 0.1*avg_n",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v if v > 0.5 else 1-v",
    "green": "v if v > 0.5 else 1-v",
    "blue": "v if v > 0.5 else 1-v"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 2663,
  "postprocess": {
    "effect": "bloom"
  }
}