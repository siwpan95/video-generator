{
  "name": "分形噪声v2 × 混沌耦合映射 × 熔岩",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.2*(sin(x*18)+sin(y*22)+sin((x+y)*25)+sin((x-y)*28)+sin(x*38+y*15)+sin(x*12-y*42))/6"
    }
