{
  "name": "进化之山",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*20)*cos(y*20)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - 2*c + avg_n - c) + 0.1*(c**2 + avg_n**2 - 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*cos(2*pi*v), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v), 0, 1)",
    "blue": "clip(1 - v, 0, 1)"
  },
  "cycle": {
    "steps": 800
  },
  "id": 3116,
  "postprocess": {
    "effect": "bloom"
  }
}