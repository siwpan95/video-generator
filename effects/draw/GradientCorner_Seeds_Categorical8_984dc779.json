{
  "name": "GradientCorner_Seeds_Categorical8_edge_180x180",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "abs(x-0.5) * abs(y-0.5)"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.5 and sum_n == 2) else 0",
