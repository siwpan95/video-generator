{
  "name": "突变图腾",
  "grid": {
    "width": 160,
    "height": 160,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "(atan2(y-0.5, x-0.5) / (2*pi) % 1 + 0.2*(x-0.5)) % 1"
