{
  "name": "StripesX_ExcitableThreshold_NormalShading_edge_300x200",
  "grid": {
    "width": 300,
    "height": 200,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(x*40) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.95)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*cos(2*pi*v), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v), 0, 1)",
    "blue": "clip(1 - v, 0, 1)"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 31380,
  "postprocess": {
    "effect": "edge"
  }
}