{
  "name": "CantorDust_NetworkDiffusion_PerceptualLab",
  "grid": {
    "width": 240,
    "height": 180,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (cos(3*pi*x)*cos(9*pi*x)*cos(27*pi*x) > 0 and cos(3*pi*y)*cos(9*pi*y)*cos(27*pi*y) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "c + f1*(avg_n - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 500
  },
  "id": 3483,
  "postprocess": {
    "effect": "edge"
  }
}