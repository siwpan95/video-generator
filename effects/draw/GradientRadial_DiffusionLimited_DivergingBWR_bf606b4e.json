{
  "name": "GradientRadial_DiffusionLimited_DivergingBWR_motion_trail_80x80",
  "grid": {
    "width": 80,
    "height": 80,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "sqrt((x-0.5)**2 + (y-0.5)**2)"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if (sum_n >= 0.5 and random() < 0.1) else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 100
  },
  "id": 50401,
  "postprocess": {
    "effect": "motion_trail"
  }
}