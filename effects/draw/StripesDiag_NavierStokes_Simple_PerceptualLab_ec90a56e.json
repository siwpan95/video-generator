{
  "name": "StripesDiag_NavierStokes_Simple_PerceptualLab_invert_600x400",
  "grid": {
    "width": 600,
    "height": 400,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin((x+y)*30) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) - f1*c*(avg_n - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 800
  },
  "id": 30400,
  "postprocess": {
    "effect": "invert"
  }
}