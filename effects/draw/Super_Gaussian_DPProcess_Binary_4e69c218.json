{
  "name": "Super_Gaussian_DPProcess_Binary",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-p1)**2 + (y-p2)**2) / (0.1*(1+w1)))"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and random() < 0.8) or (c <= 0.5 and sum_n >= 0.5 and random() < 0.4) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "1 if v > 0.5 else 0",
    "green": "1 if v > 0.5 else 0",
    "blue": "1 if v > 0.5 else 0"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 2573,
  "postprocess": {
    "effect": "motion_trail"
  }
}