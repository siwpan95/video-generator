{
  "name": "Super_Gaussian_ForestFire_PerceptualLab",
  "grid": {
    "width": 80,
    "height": 60,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-p1)**2 + (y-p2)**2) / (0.1*(1+w1)))"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.5 and sum_n >= 0.5) else (0 if c > 0.5 else c)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 600
  },
  "id": 1567,
  "postprocess": {
    "effect": "vignette"
  }
}