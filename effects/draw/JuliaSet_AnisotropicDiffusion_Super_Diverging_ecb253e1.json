{
  "name": "晨曦之浪",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x*3-1.5)**2 + (y*3-1.5)**2 < 4) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
