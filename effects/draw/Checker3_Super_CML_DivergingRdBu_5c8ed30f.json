{
  "name": "Checker3_Super_CML_DivergingRdBu_bloom_200x200",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((int(x*6) + int(y*6)) % 2 == 0) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip(v*2 if v < 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 5000
  },
  "id": 30365,
  "postprocess": {
    "effect": "bloom"
  }
}