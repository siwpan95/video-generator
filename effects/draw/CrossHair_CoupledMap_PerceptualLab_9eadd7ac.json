{
  "name": "CrossHair_CoupledMap_PerceptualLab",
  "grid": {
    "width": 512,
    "height": 384,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.01 or abs(y-0.5) < 0.01) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - 0.1)*c + 0.1*avg_n",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 1314,
  "postprocess": {
    "effect": "invert"
  }
}