{
  "name": "半面激活 × 反应扩散（迷宫） × 紫色梦境",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "random() if x < 0.5 else 0.0"
    }
  },
  "evolution": {
    "rule": "c + 0.24*(avg_n - c) + 0.055*c*(1-c) - 0.038*c",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "v*0.65 + 0.35*sin(v*5.5)*v",
    "green": "v*0.04",
    "blue": "v*0.85 + 0.12*cos(v*6.5)*v"
  },
  "id": 30
}