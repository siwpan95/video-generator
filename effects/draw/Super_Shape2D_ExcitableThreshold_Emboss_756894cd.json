{
  "name": "脉动之影",
  "grid": {
    "width": 320,
    "height": 240,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "(((x-p1)/w1)**2 + ((y-p2)/w2)**2 < 1) * 1.0"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.95)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "v + 0.2*sin(20*v)",
    "green": "v + 0.1*sin(20*v)",
    "blue": "v - 0.1*sin(20*v)"
  },
  "cycle": {
    "steps": 5000
  },
  "id": 32087,
  "postprocess": {
    "effect": "motion_trail"
  }
}