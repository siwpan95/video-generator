{
  "name": "Super_Shape2D_Schrodinger_Real_Super_Diverging_bloom_80x80",
  "grid": {
    "width": 80,
    "height": 80,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "(((x-p1)/w1)**2 + ((y-p2)/w2)**2 < 1) * 1.0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - 2*c + avg_n - c) + 0.1*(c**2 + avg_n**2 - 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + f1*(v-0.5), 0, 1)",
    "green": "clip(1 - f2*2*abs(v-0.5), 0, 1)",
    "blue": "clip(0.5 - f3*(v-0.5), 0, 1)"
  },
  "cycle": {
    "steps": 100
  },
  "id": 50350,
  "postprocess": {
    "effect": "bloom"
  }
}