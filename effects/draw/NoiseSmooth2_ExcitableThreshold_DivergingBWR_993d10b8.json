{
  "name": "NoiseSmooth2_ExcitableThreshold_DivergingBWR_bloom_200x200",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.3*random()"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.95)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 3000
  },
  "id": 50680,
  "postprocess": {
    "effect": "bloom"
  }
}