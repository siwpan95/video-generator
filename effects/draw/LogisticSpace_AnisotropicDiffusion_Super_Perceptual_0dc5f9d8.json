{
  "name": "纠缠之森",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "3.8*x*(1-x)*3.8*y*(1-y)"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v**abs(p1), 0, 1)",
    "green": "clip(v**abs(p2), 0, 1)",
    "blue": "clip(v**abs(p3), 0, 1)"
  },
  "cycle": {
    "steps": 800
  },
  "id": 3364,
  "postprocess": {
    "effect": "edge"
  }
}