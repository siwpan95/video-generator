{
  "name": "Super_WaveEquation2D_IsingGlauber_NormalShading_motion_trail_150x150",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "sin(2*pi*f1*sqrt((x-p1)**2 + (y-p2)**2)) * exp(-((x-p1)**2 + (y-p2)**2)/w1)"
    }
  },
  "evolution": {
    "rule": "1 if (sum_n > 2 and c <= 0.5) or (sum_n < 2 and c > 0.5) else c",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*cos(2*pi*v), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v), 0, 1)",
    "blue": "clip(1 - v, 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 31236,
  "postprocess": {
    "effect": "motion_trail"
  }
}