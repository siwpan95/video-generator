{
  "name": "Super_Noise_RosslerMap_DivergingBWR_edge_100x100",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "clip(w1*random() + p1, 0, 1)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(-c - avg_n)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 100
  },
  "id": 31262,
  "postprocess": {
    "effect": "edge"
  }
}