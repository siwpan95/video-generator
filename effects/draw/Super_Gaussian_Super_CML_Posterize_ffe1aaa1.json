{
  "name": "Super_Gaussian_Super_CML_Posterize_motion_trail_100x100",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-p1)**2 + (y-p2)**2) / (0.1*(1+w1)))"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.25*int(v*4)",
    "green": "0.25*int(v*4)",
    "blue": "0.25*int(v*4)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 30300,
  "postprocess": {
    "effect": "motion_trail"
  }
}