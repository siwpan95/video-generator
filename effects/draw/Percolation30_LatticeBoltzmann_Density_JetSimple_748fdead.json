{
  "name": "Percolation30_LatticeBoltzmann_Density_JetSimple",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if random() < 0.3 else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) - 0.01*(c - 0.5)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(4*v-1.5, 0, 1)",
    "green": "clip(4*v-0.5, 0, 1)",
    "blue": "clip(-4*v+2.5, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 3523,
  "postprocess": {
    "effect": "invert"
  }
}