{
  "name": "WaveEquation2D_CoupledMap_Solarize",
  "grid": {
    "width": 128,
    "height": 128,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "sin(2*pi*5*sqrt((x-0.5)**2 + (y-0.5)**2)) * exp(-((x-0.5)**2 + (y-0.5)**2)/0.01)"
    }
  },
  "evolution": {
    "rule": "(1 - 0.1)*c + 0.1*avg_n",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v if v > 0.5 else 1-v",
    "green": "v if v > 0.5 else 1-v",
    "blue": "v if v > 0.5 else 1-v"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 1320,
  "postprocess": {
    "effect": "edge"
  }
}