{
  "name": "FourSources_Super_PhaseSep_DivergingRdBu_bloom_80x80",
  "grid": {
    "width": 80,
    "height": 80,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.25)**2+(y-0.25)**2<0.01 or (x-0.75)**2+(y-0.25)**2<0.01 or (x-0.25)**2+(y-0.75)**2<0.01 or (x-0.75)**2+(y-0.75)**2<0.01) else 0"
    }
  },
  "evolution": {
    "rule": "c + f1*(avg_n - c) - f2*(c**3 - w1*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip(v*2 if v < 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 30853,
  "postprocess": {
    "effect": "bloom"
  }
}