{
  "name": "Grid_Schrodinger_Real_PerceptualMono_edge_160x160",
  "grid": {
    "width": 160,
    "height": 160,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(x*30) * sin(y*30) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - 2*c + avg_n - c) + 0.1*(c**2 + avg_n**2 - 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v**0.8, 0, 1)",
    "green": "clip(v**0.9, 0, 1)",
    "blue": "clip(v**1.2, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 50309,
  "postprocess": {
    "effect": "edge"
  }
}