{
  "name": "FourSources_LatticeBoltzmann_Density_Super_Thermal_none_180x180",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.25)**2+(y-0.25)**2<0.01 or (x-0.75)**2+(y-0.25)**2<0.01 or (x-0.25)**2+(y-0.75)**2<0.01 or (x-0.75)**2+(y-0.75)**2<0.01) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) - 0.01*(c - 0.5)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*f1, 0, 1)",
    "green": "clip(v*(1-v)*f2*4, 0, 1)",
    "blue": "clip((1-v)*f3, 0, 1)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 50142
}