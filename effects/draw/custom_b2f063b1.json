{
  "name": "水面波纹 - 2D波动方程",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-0.3)**2+(y-0.5)**2)/0.005) + exp(-((x-0.7)**2+(y-0.5)**2)/0.005)"
    }
  },
  "neighborhood": {
    "type": "moore",
    "radius": 1
  },
  "evolution": {
    "rule": "max(0, min(1, 2*avg_n - c + 0.999*(c - avg_n)))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.1 + 0.9 * (0.5 + 0.5*v)",
    "green": "0.2 + 0.8 * (0.5 + 0.5*v)",
    "blue": "0.5 + 0.5 * (0.5 + 0.5*v)"
  },
  "tick": {
    "fps": 30,
    "steps_per_frame": 1
  },
  "cycle": {
    "steps": 300
  },
  "id": 122
}