{
  "name": "Super_Fractal_Super_Threshold_Categorical4_motion_trail_128x128",
  "grid": {
    "width": 128,
    "height": 128,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(f1*pi*x)*sin(f2*pi*x)*sin(f3*pi*x) * sin(f1*pi*y)*sin(f2*pi*y)*sin(f3*pi*y)) > w1 else 0"
    }
  },
  "evolution": {
    "rule": "clip(c + f1*(avg_n - c) + f2*(0.5 - abs(c - 0.5)), 0, 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1 if v < 0.25 else (0 if v < 0.5 else (1 if v < 0.75 else 0.2))",
    "green": "0.5 if v < 0.25 else (1 if v < 0.5 else (0.5 if v < 0.75 else 0))",
    "blue": "0 if v < 0.25 else (0.5 if v < 0.5 else (1 if v < 0.75 else 1))"
  },
  "cycle": {
    "steps": 200
  },
  "id": 30075,
  "postprocess": {
    "effect": "motion_trail"
  }
}