{
  "name": "星云之变_1",
  "grid": {
    "width": 240,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.01 or abs(y-0.5) < 0.01) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) + f1*(avg_n - c)*(sum_n - 4*c)",
    "variables": [
      "c",
      "avg_n",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v*f1 + p1 if v < w1 else (v-1)*f2 + p2, 0, 1)",
    "green": "clip(v*f3 + p3 if v < w1 else (v-1)*f4 + p4, 0, 1)",
    "blue": "clip(v*f5 + p5 if v < w1 else (v-1)*f6 + p6, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 32168,
  "postprocess": {
    "effect": "edge"
  }
}