{
  "name": "GaussianRing_ChenMap_NormalShading_invert_100x100",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((sqrt((x-0.5)**2 + (y-0.5)**2) - 0.3)**2) / 0.01)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(p1*(avg_n - c) + f1*avg_n)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*cos(2*pi*v), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v), 0, 1)",
    "blue": "clip(1 - v, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 20440,
  "postprocess": {
    "effect": "invert"
  }
}