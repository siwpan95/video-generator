{
  "name": "Disclination_ExcitableThreshold_PerceptualLab_motion_trail_160x160",
  "grid": {
    "width": 160,
    "height": 160,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "(atan2(y-0.5, x-0.5) / (2*pi) % 1 + 0.2*(x-0.5)) % 1"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.95)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 50812,
  "postprocess": {
    "effect": "motion_trail"
  }
}