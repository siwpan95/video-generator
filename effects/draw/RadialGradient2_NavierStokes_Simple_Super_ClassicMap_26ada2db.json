{
  "name": "涌现之歌",
  "grid": {
    "width": 240,
    "height": 180,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "abs(x-0.5) + abs(y-0.5)"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) - f1*c*(avg_n - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(f1*v + p1, 0, 1)",
    "green": "clip(f2*v*(1-v)*4 + p2, 0, 1)",
    "blue": "clip(f3*(1-v) + p3, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 3102,
  "postprocess": {
    "effect": "motion_trail"
  }
}