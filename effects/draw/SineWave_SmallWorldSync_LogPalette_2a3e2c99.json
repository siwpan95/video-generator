{
  "name": "炼狱之舞",
  "grid": {
    "width": 512,
    "height": 384,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*cos(y*20)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*sin(avg_n - c) + 0.001*sin(2*(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "log(1+v*9)/log(10)",
    "green": "log(1+v*9)/log(10)",
    "blue": "log(1+v*9)/log(10)"
  },
  "cycle": {
    "steps": 500
  },
  "id": 3032,
  "postprocess": {
    "effect": "edge"
  }
}