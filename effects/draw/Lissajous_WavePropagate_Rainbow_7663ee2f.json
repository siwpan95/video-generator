{
  "name": "Lissajous_波传播_彩虹",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(3*x*20)*sin(2*y*20) > 0.5) else 0"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.5 and sum_n >= 1) else (c * 0.9)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*sin(2*pi*v+4*pi/3)"
  },
  "id": 41
}