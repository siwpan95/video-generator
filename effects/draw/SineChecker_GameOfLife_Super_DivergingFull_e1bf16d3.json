{
  "name": "进化星轨",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*20)*cos(y*20)"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and sum_n >= 2 and sum_n <= 3) or (c <= 0.5 and sum_n == 3) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(f1*(v - 0.5) + 0.5 if v > 0.5 else 0.5 - f2*(0.5 - v), 0, 1)",
    "green": "clip(1 - f3*2*abs(v-0.5), 0, 1)",
    "blue": "clip(f4*(0.5 - v) + 0.5 if v < 0.5 else 0.5 - f5*(v - 0.5), 0, 1)"
  },
  "cycle": {
    "steps": 3000
  },
  "id": 31792,
  "postprocess": {
    "effect": "motion_trail"
  }
}