{
  "name": "StandingWave_ForestFire_DivergingBWR",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "(sin(2*pi*x*10))**2"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.5 and sum_n >= 0.5) else (0 if c > 0.5 else c)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 1861,
  "postprocess": {
    "effect": "invert"
  }
}