{
  "name": "Super_Noise_Super_CML_DivergingBWR_512x384",
  "grid": {
    "width": 512,
    "height": 384,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "clip(w1*random() + p1, 0, 1)"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
