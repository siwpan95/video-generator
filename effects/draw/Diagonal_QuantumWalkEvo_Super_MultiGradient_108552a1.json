{
  "name": "时光之山",
  "grid": {
    "width": 240,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-y) < 0.03) else 0"
    }
  },
  "evolution": {
    "rule": "0.5*c + 0.5*avg_n + 0.1*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*f1 + p1 if v < w1 else (v-1)*f2 + p2, 0, 1)",
    "green": "clip(v*f3 + p3 if v < w1 else (v-1)*f4 + p4, 0, 1)",
    "blue": "clip(v*f5 + p5 if v < w1 else (v-1)*f6 + p6, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 2954,
  "postprocess": {
    "effect": "motion_trail"
  }
}