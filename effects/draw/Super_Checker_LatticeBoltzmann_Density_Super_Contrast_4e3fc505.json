{
  "name": "Super_Checker_LatticeBoltzmann_Density_Super_Contrast_invert_160x160",
  "grid": {
    "width": 160,
    "height": 160,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*f1*pi)*sin(y*f2*pi)"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) - 0.01*(c - 0.5)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip((v-0.5)*c1+0.5, 0, 1)",
    "green": "clip((v-0.5)*c2+0.5, 0, 1)",
    "blue": "clip((v-0.5)*c3+0.5, 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 50112,
  "postprocess": {
    "effect": "invert"
  }
}