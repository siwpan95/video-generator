{
  "name": "Super_Gaussian_EdenGrowth_PerceptualLab_motion_trail_600x400_c800",
  "grid": {
    "width": 600,
    "height": 400,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-p1)**2 + (y-p2)**2) / (0.1*(1+w1)))"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if (sum_n >= 0.5 and random() < 0.3) else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 800
  },
  "id": 51855,
  "postprocess": {
    "effect": "motion_trail"
  }
}