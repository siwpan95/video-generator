      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v*(1-v)*4",
    "green": "v",
    "blue": "0"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 30272,
  "postprocess": {
    "effect": "edge"
  }
}