{
  "name": "等离子消散",
  "grid": {
    "width": 512,
    "height": 384,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*20)*cos(y*20)"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if (sum_n >= 0.5 and random() < 0.3) else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip(v*2 if v < 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 800
  },
  "id": 21904,
  "postprocess": {
    "effect": "edge"
  }
}