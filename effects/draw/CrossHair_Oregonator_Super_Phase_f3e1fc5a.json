{
  "name": "进化余辉",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.01 or abs(y-0.5) < 0.01) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) + 0.5*c*(1 - c)*(c - 0.3)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*cos(2*pi*v*f1+p1)",
    "green": "0.5+0.5*cos(2*pi*v*f2+p2)",
    "blue": "0.5+0.5*cos(2*pi*v*f3+p3)"
  },
  "cycle": {
    "steps": 800
  },
  "id": 2999,
  "postprocess": {
    "effect": "vignette"
  }
}