{
  "name": "黑洞之谜",
  "grid": {
    "width": 80,
    "height": 80,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "(sin(8*pi*x)*sin(8*pi*y) > 0) * 1.0"
    }
  },
  "evolution": {
    "rule": "(1 - 0.2)*3.8*c*(1-c) + 0.2*3.8*avg_n*(1-avg_n)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 500
  },
  "id": 31710,
  "postprocess": {
    "effect": "edge"
  }
}