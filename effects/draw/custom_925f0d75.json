{
  "name": "正弦条纹 × 反应扩散（斑点） × 深海",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.3 + 0.2 * sin(x*20) * cos(y*20)"
    }
  },
  "evolution": {
    "rule": "c + 0.14*(avg_n - c) + 0.042*c*(1-c) - 0.018*c",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "v*0.05",
    "green": "v*0.35 + 0.15*sin(v*8)*v",
    "blue": "v*0.75 + 0.15*cos(v*6)*v"
  },
  "id": 64
}