{
  "name": "Percolation50_Super_CML_Solarize_motion_trail_600x400",
  "grid": {
    "width": 600,
    "height": 400,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if random() < 0.5 else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1-v if v > 0.5 else v",
    "green": "1-v if v > 0.5 else v",
    "blue": "1-v if v > 0.5 else v"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 30320,
  "postprocess": {
    "effect": "motion_trail"
  }
}