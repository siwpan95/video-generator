{
  "name": "Super_Julia_Super_CML_Super_IQPalette_invert_180x180",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x*3-1.5)**2 + (y*3-1.5)**2 < 4) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*cos(2*pi*(v*p1+d1))",
    "green": "0.5+0.5*cos(2*pi*(v*p2+d2))",
    "blue": "0.5+0.5*cos(2*pi*(v*p3+d3))"
  },
  "cycle": {
    "steps": 500
  },
  "id": 20081,
  "postprocess": {
    "effect": "invert"
  }
}