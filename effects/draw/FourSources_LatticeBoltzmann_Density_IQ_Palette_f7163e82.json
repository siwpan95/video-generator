      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*cos(2*pi*(v*0.9+0.1))",
    "green": "0.5+0.5*cos(2*pi*(v*0.7+0.3))",
    "blue": "0.5+0.5*cos(2*pi*(v*0.5+0.5))"
  },
  "cycle": {
    "steps": 200
  },
  "id": 50143,
  "postprocess": {
    "effect": "edge"
  }
