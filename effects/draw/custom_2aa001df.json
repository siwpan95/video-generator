{
  "name": "闪电分叉 × FitzHugh–Nagumo × 霓虹热感",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "max(0.0, 1.0 - 12*abs(y - 0.45 - 0.12*sin(x*18) - 0.06*sin(x*37))) * random()"
    }
  },
  "evolution": {
    "rule": "c + 0.07*(avg_n-c) + 0.28*c*(c-0.18)*(1-c) - 0.035*(c-0.3)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "min(v*3, 1.0)",
    "green": "max(0, min((v-0.33)*3, 1.0))",
    "blue": "max(0, (v-0.66)*3)"
  },
  "id": 40
}