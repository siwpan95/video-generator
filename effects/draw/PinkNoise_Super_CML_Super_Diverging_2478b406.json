{
  "name": "PinkNoise_Super_CML_Super_Diverging_bloom_64x64",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(random()*100)*sin(random()*100)"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + f1*(v-0.5), 0, 1)",
    "green": "clip(1 - f2*2*abs(v-0.5), 0, 1)",
    "blue": "clip(0.5 - f3*(v-0.5), 0, 1)"
  },
  "cycle": {
    "steps": 600
  },
  "id": 30276,
  "postprocess": {
    "effect": "bloom"
  }
}