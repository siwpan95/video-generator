{
  "name": "星云之旋",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(random()*100)*sin(random()*100)"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if (sum_n >= 0.5 and random() < 0.1) else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "0.5 + 0.5*sin(2*pi*v*f1 + p1)",
    "green": "0.5 + 0.5*sin(2*pi*v*f2 + p2)",
    "blue": "0.5 + 0.5*cos(2*pi*v*f3 + p3)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 3371,
  "postprocess": {
    "effect": "edge"
  }
}