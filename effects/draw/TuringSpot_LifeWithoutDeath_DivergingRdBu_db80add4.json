{
  "name": "时光之影",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(14*x)*sin(14*y) + 0.3*random()"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if sum_n >= 3 else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip(v*2 if v < 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 31839,
  "postprocess": {
    "effect": "bloom"
  }
}