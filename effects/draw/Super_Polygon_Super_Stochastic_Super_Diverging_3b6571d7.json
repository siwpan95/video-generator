{
  "name": "Super_Polygon_Super_Stochastic_Super_Diverging_vignette_200x150",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "((x-p1)**2 + (y-p2)**2 < w1**2) * 1.0"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if (sum_n >= f1 and random() < f2) else 0)",
