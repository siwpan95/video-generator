{
  "name": "趋化性_聚集",
  "version": "1.0",
  "description": "趋化性简化模型：细胞沿化学梯度聚集。用c表示细胞密度，梯度近似为邻域差异",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-0.3)**2+(y-0.5)**2)/0.02) + exp(-((x-0.7)**2+(y-0.5)**2)/0.02)"
    }
  },
  "neighborhood": {
    "type": "moore",
    "radius": 1
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) + 0.05*c*(avg_n - c) + 0.01*sin(12.566*x*y)",
    "variables": [
      "c",
      "avg_n",
      "x",
      "y"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "v*0.9",
    "green": "0.2 + 0.8*v*v",
    "blue": "0.5 + 0.5*sin(v*15)"
  },
  "tick": {
    "fps": 22,
    "steps_per_frame": 1
  },
  "cycle": {
    "steps": 350
  },
  "id": 179
}