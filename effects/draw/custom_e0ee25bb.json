{
  "name": "BZ反应 - 化学振荡波",
  "version": "1.0",
  "grid": {
    "width": 300,
    "height": 200,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.5)*(x-0.5)+(y-0.5)*(y-0.5))<0.001 else 0"
    }
  },
  "neighborhood": {
    "type": "moore",
    "radius": 1
  },
  "evolution": {
    "rule": "c + 0.05*(avg_n - c) + 0.12*c*(1-c)*(c-0.3) + 0.01*sin(t*0.2)",
    "variables": [
      "c",
      "avg_n",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.1 if v < 0.3 else (v*2 if v < 0.7 else 1.0)",
    "green": "v*0.3 if v < 0.5 else (1.0 - v)",
    "blue": "(v-0.5)*2 if v > 0.5 else (1.0 - v*2)"
  },
  "tick": {
    "fps": 15,
    "steps_per_frame": 1
  },
  "cycle": {
    "steps": 350
  },
  "id": 6
}