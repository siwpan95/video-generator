{
  "name": "超级公式_高斯_耦合_超级渐变",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-0.5)**2 + (y-0.5)**2) / (0.1*(1+0.5)))"
    }
  },
  "evolution": {
    "rule": "(1 - 1.0)*c + 1.0*avg_n + 1.0*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "clip(0.0 + 1.0*v, 0, 1)",
    "green": "clip(0.0 + 1.0*v, 0, 1)",
    "blue": "clip(0.0 + 1.0*v, 0, 1)"
  },
  "id": 168
}