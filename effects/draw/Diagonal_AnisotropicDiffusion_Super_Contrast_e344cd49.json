{
  "name": "银河消散",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-y) < 0.03) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
