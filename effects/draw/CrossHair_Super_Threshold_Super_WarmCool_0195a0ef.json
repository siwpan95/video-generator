{
  "name": "晶格余辉",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.01 or abs(y-0.5) < 0.01) else 0"
    }
  },
  "evolution": {
    "rule": "clip(c + f1*(avg_n - c) + f2*(0.5 - abs(c - 0.5)), 0, 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*sin(v*pi*f1+d1)",
    "green": "v",
    "blue": "0.5+0.5*cos(v*pi*f2+d2)"
  },
  "cycle": {
    "steps": 0
  },
  "id": 52388,
  "postprocess": {
    "effect": "edge"
  }
}