{
  "name": "时光之舞",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(sqrt((x-0.5)**2 + (y-0.5)**2) - 0.3) < 0.02) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) + 0.01*sin(c*20)",
