{
  "name": "Cateye_Schrodinger_Real_DivergingBWR_v55",
  "grid": {
    "width": 160,
    "height": 120,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.5)**2/0.04 + (y-0.5)**2/0.01 < 1) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - 2*c + avg_n - c) + 0.1*(c**2 + avg_n**2 - 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 3435,
  "postprocess": {
    "effect": "motion_trail"
  }
}