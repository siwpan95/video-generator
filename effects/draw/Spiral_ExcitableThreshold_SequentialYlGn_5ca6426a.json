{
  "name": "Spiral_ExcitableThreshold_SequentialYlGn_edge_150x150",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((atan2(y-0.5, x-0.5) / (2*pi) + sqrt((x-0.5)**2 + (y-0.5)**2) * 2) % 1 < 0.5) else 0 + 0.05*random()"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.98) + 0.01*random()",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "v*(1-v)*4",
    "green": "v",
    "blue": "0"
  },
  "cycle": {
    "steps": 200
  },
  "id": 50720,
  "postprocess": {
    "effect": "edge"
  }
}