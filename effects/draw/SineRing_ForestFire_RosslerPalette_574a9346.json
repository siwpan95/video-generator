  "color": {
    "red": "v",
    "green": "0.5+0.5*sin(4*pi*v)",
    "blue": "0.5+0.5*cos(4*pi*v)"
  },
  "cycle": {
    "steps": 1500
  },
  "id": 30460,
  "postprocess": {
    "effect": "motion_trail"
  }
}