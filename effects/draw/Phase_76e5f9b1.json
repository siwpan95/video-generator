{
  "name": "多公式_正弦+高斯_init_扩散+反应_evo_IQ+热力_color",
  "version": "2.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5*(0.5 + 0.5*sin(x*20)*cos(y*20)) + 0.5*exp(-((x-0.5)**2 + (y-0.5)**2)/0.04)"
    }
  },
  "evolution": {
    "rule": "where(t < 100, c + 0.2*(avg_n - c), c + 0.2*(avg_n - c) + 0.1*c*(1 - c))",
    "variables": [
      "c",
      "avg_n",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*v)",
    "green": "0.5+0.5*cos(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*cos(2*pi*v+4*pi/3)"
  },
  "id": 106
}