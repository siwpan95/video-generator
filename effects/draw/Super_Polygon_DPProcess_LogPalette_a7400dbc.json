{
  "name": "Super_Polygon_DPProcess_LogPalette",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "((x-p1)**2 + (y-p2)**2 < w1**2) * 1.0"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and random() < 0.8) or (c <= 0.5 and sum_n >= 0.5 and random() < 0.4) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "log(1+v*9)/log(10)",
    "green": "log(1+v*9)/log(10)",
    "blue": "log(1+v*9)/log(10)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 1356,
  "postprocess": {
    "effect": "edge"
  }
}