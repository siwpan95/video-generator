{
  "name": "潮汐回响",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if random() < 0.6 else 0"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.95)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(f1*(v - 0.5) + 0.5 if v > 0.5 else 0.5 - f2*(0.5 - v), 0, 1)",
    "green": "clip(1 - f3*2*abs(v-0.5), 0, 1)",
    "blue": "clip(f4*(0.5 - v) + 0.5 if v < 0.5 else 0.5 - f5*(v - 0.5), 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 21689,
  "postprocess": {
    "effect": "edge"
  }
}