    "green": "clip(v**0.9, 0, 1)",
    "blue": "clip(v**1.2, 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 50685,
  "postprocess": {
    "effect": "edge"
  }
}