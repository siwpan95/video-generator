{
  "name": "PinkNoise_NavierStokes_Simple_DivergingRdBu_none_150x150",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(random()*100)*sin(random()*100)"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) - f1*c*(avg_n - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip(v*2 if v < 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 600
  },
  "id": 31218
}