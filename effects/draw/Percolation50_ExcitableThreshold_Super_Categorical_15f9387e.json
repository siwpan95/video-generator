{
  "name": "Percolation50_ExcitableThreshold_Super_Categorical_motion_trail_600x400",
  "grid": {
    "width": 600,
    "height": 400,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if random() < 0.5 else 0"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.95)",
