      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(sin(2*pi*v*f1 + p1)*0.5 + 0.5, 0, 1)",
    "green": "clip(sin(2*pi*v*f2 + p2)*0.5 + 0.5, 0, 1)",
    "blue": "clip(sin(2*pi*v*f3 + p3)*0.5 + 0.5, 0, 1)"
  },
  "cycle": {
    "steps": 5000
  },
  "id": 50801,
  "postprocess": {
    "effect": "motion_trail"
  }
}