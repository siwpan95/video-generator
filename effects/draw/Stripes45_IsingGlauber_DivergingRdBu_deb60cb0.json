{
  "name": "时光绽放_1",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin((x+y)*25) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "1 if (sum_n > 2 and c <= 0.5) or (sum_n < 2 and c > 0.5) else c",
