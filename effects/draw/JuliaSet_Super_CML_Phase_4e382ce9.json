{
  "name": "Super_Julia_Super_CML_Phase_motion_trail_400x300",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x*3-1.5)**2 + (y*3-1.5)**2 < 4) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*cos(2*pi*v)",
    "green": "0.5+0.5*cos(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*cos(2*pi*v+4*pi/3)"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 20080,
  "postprocess": {
    "effect": "motion_trail"
  }
}