{
  "name": "超级公式_波包反应IQ",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-0.5)**2 + (y-0.5)**2)/(0.04+0.5))*sin(1.0*20*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "c + 1.0*(avg_n - c) + 1.0*c*(0.5 - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*(v*0.5+0.0))",
    "green": "0.5+0.5*cos(2*pi*(v*0.5+0.0))",
    "blue": "0.5+0.5*cos(2*pi*(v*0.5+0.0))"
  },
  "id": 162
}