{
  "name": "WaveEquation2D_DoubleSlit_AnisotropicDiffusion_Spring",
  "grid": {
    "width": 600,
    "height": 400,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "sin(2*pi*10*(x-0.3)) * (exp(-((y-0.3)**2)/0.01) + exp(-((y-0.7)**2)/0.01)) * (abs(x-0.3) < 0.1)"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1",
    "green": "0.5+0.5*v",
    "blue": "v"
  },
  "cycle": {
    "steps": 500
  },
  "id": 1931,
  "postprocess": {
    "effect": "motion_trail"
  }
}