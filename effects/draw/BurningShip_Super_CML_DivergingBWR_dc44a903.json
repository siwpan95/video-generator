{
  "name": "BurningShip_Super_CML_DivergingBWR_invert_100x100",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x*3-1.5) + abs(y*3-1.5) < 2) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 100
  },
  "id": 30373,
  "postprocess": {
    "effect": "invert"
  }
}