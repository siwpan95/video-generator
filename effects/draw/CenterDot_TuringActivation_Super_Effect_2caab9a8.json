{
  "name": "微光之山",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.03 and abs(y-0.5) < 0.03) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) + 0.01*sin(c*20)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v + f1*sin(20*v*pi + p1), 0, 1)",
    "green": "clip(v + f2*sin(20*v*pi + p2), 0, 1)",
    "blue": "clip(v + f3*sin(20*v*pi + p3), 0, 1)"
  },
  "cycle": {
    "steps": 1500
  },
  "id": 21691,
  "postprocess": {
    "effect": "motion_trail"
  }
}