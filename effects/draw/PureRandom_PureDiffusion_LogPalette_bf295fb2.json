{
  "name": "随机_扩散_对数",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "random()"
    }
  },
  "evolution": {
    "rule": "c + 0.20*(avg_n - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "log(1+v*9)/log(10)",
    "green": "log(1+v*9)/log(10)",
    "blue": "log(1+v*9)/log(10)"
  },
  "id": 185
}