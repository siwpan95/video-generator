      "avg_n"
    ]
  },
  "color": {
    "red": "v + 0.2*sin(20*v)",
    "green": "v + 0.1*sin(20*v)",
    "blue": "v - 0.1*sin(20*v)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 21882,
  "postprocess": {
    "effect": "motion_trail"
  }
