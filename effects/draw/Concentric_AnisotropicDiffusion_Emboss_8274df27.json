{
  "name": "幻境之山_1",
  "grid": {
    "width": 512,
    "height": 384,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(sqrt((x-0.5)**2 + (y-0.5)**2) - 0.3) < 0.02) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
