{
  "name": "平面波_传播_彩虹",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(2*pi*(x*cos(0.3) + y*sin(0.3)))"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.5 and sum_n >= 1) else (c * 0.9)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*sin(2*pi*v+4*pi/3)"
  },
  "id": 113
}