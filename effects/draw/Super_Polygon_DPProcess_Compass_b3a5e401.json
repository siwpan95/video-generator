{
  "name": "黑洞光年",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "((x-p1)**2 + (y-p2)**2 < w1**2) * 1.0"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and random() < 0.8) or (c <= 0.5 and sum_n >= 0.5 and random() < 0.4) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+pi/2)",
    "blue": "0.5+0.5*sin(2*pi*v+pi)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 52821,
  "postprocess": {
    "effect": "edge"
  }
}