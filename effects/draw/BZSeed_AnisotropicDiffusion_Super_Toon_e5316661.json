    "green": "clip(p2 + (1-p2)*int(v*f1)/f1, 0, 1)",
    "blue": "clip(p3 + (1-p3)*int(v*f1)/f1, 0, 1)"
  },
  "cycle": {
    "steps": 5000
  },
  "id": 22187,
  "postprocess": {
    "effect": "invert"
  }
