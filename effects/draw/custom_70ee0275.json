{
  "name": "反应扩散_正弦种子",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.3 + 0.2 * sin(x*20) * cos(y*20)"
    }
  },
  "evolution": {
    "rule": "c + 0.16*(avg_n - c) + 0.045*c*(1-c) - 0.02*c",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "v * 0.8",
    "green": "1.0 - v * 0.7",
    "blue": "v * 0.9"
  },
  "cycle": {
    "steps": 350
  },
  "id": 92
}