{
  "name": "纠缠序曲",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "sqrt((x-0.5)**2 + (y-0.5)**2)"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and random() < 0.8) or (c <= 0.5 and sum_n >= 0.5 and random() < 0.4) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v*f1, 0, 1)",
    "green": "clip(v*(1-v)*f2*4, 0, 1)",
    "blue": "clip((1-v)*f3, 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 21972,
  "postprocess": {
    "effect": "invert"
  }
}