{
  "name": "JuliaSet2_CoupledMap_PerceptualLab",
  "grid": {
    "width": 128,
    "height": 128,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x*3-1.5)**2 + (y*3-1.5)**2 < 4) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - 0.1)*c + 0.1*avg_n",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 1290,
  "postprocess": {
    "effect": "edge"
  }
}