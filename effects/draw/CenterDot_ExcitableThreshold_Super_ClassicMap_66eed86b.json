{
  "name": "CenterDot_ExcitableThreshold_Super_ClassicMap",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.03 and abs(y-0.5) < 0.03) else 0"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.95)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(f1*v + p1, 0, 1)",
    "green": "clip(f2*v*(1-v)*4 + p2, 0, 1)",
    "blue": "clip(f3*(1-v) + p3, 0, 1)"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 2071,
  "postprocess": {
    "effect": "vignette"
  }
}