{
  "name": "黑洞之梦",
  "grid": {
    "width": 80,
    "height": 80,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(x*40) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*sin(avg_n - c) + 0.001*sin(2*(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 22094,
  "postprocess": {
    "effect": "edge"
  }
}