{
  "name": "Super_Julia_Super_CML_Solarize_motion_trail_320x240",
  "grid": {
    "width": 320,
    "height": 240,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x*3-1.5)**2 + (y*3-1.5)**2 < 4) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1-v if v > 0.5 else v",
    "green": "1-v if v > 0.5 else v",
    "blue": "1-v if v > 0.5 else v"
  },
  "cycle": {
    "steps": 200
  },
  "id": 20078,
  "postprocess": {
    "effect": "motion_trail"
  }
}