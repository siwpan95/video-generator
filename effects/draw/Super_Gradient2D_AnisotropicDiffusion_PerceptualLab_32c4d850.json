{
  "name": "Super_Gradient2D_AnisotropicDiffusion_PerceptualLab_motion_trail_400x300",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "clip(p1 + w1*abs(x-p2) + w2*abs(y-p3), 0, 1)"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 1500
  },
  "id": 31399,
  "postprocess": {
    "effect": "motion_trail"
  }
}