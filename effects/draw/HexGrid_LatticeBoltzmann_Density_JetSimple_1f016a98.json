{
  "name": "HexGrid_LatticeBoltzmann_Density_JetSimple_edge_150x150",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(x*34.64) + sin(y*40) > 1.5) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) - 0.01*(c - 0.5)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(4*v-1.5, 0, 1)",
    "green": "clip(4*v-0.5, 0, 1)",
    "blue": "clip(-4*v+2.5, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 50136,
  "postprocess": {
    "effect": "edge"
  }
}