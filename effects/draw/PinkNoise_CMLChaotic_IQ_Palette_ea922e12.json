{
  "name": "粉红噪声_CML_IQ",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(random()*100)*sin(random()*100)"
    }
  },
  "evolution": {
    "rule": "(1 - 0.2)*3.8*c*(1-c) + 0.2*3.8*avg_n*(1-avg_n)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*(v*0.9+0.1))",
    "green": "0.5+0.5*cos(2*pi*(v*0.7+0.3))",
    "blue": "0.5+0.5*cos(2*pi*(v*0.5+0.5))"
  },
  "id": 140
}