{
  "name": "Super_Shape2D_Super_CML_Binary_bloom_100x100",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "(((x-p1)/w1)**2 + ((y-p2)/w2)**2 < 1) * 1.0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1 if v > 0.5 else 0",
    "green": "1 if v > 0.5 else 0",
    "blue": "1 if v > 0.5 else 0"
  },
  "cycle": {
    "steps": 0
  },
  "id": 20022,
  "postprocess": {
    "effect": "bloom"
  }
}