      "avg_n"
    ]
  },
  "color": {
    "red": "clip((v-0.5)*c1+0.5, 0, 1)",
    "green": "clip((v-0.5)*c2+0.5, 0, 1)",
    "blue": "clip((v-0.5)*c3+0.5, 0, 1)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 1032,
  "postprocess": {
    "effect": "invert"
  }
}