{
  "name": "Super_Shape2D_AnisotropicDiffusion_Super_Contrast",
  "grid": {
    "width": 160,
    "height": 120,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "(((x-p1)/w1)**2 + ((y-p2)/w2)**2 < 1) * 1.0"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
