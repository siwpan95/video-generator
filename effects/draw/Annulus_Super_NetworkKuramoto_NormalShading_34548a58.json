{
  "name": "幻境之海",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (0.2 < (x-0.5)**2 + (y-0.5)**2 < 0.25) else 0"
    }
  },
  "evolution": {
    "rule": "c + f1*sin(avg_n - c) + f2*sin(2*(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*cos(2*pi*v), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v), 0, 1)",
    "blue": "clip(1 - v, 0, 1)"
  },
  "cycle": {
    "steps": 0
  },
  "id": 3240,
  "postprocess": {
    "effect": "edge"
  }
}