{
  "name": "圆波_湍流_彩虹",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(20*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "c + 0.2*(avg_n - c)",
    "variables": [
      "c",
      "sum_n",
      "avg_n",
      "x",
      "y",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*sin(2*pi*v+4*pi/3)"
  },
  "id": 98
}