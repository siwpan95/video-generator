{
  "name": "HalfHalf_CMLChaotic_DivergingBWR_motion_trail_180x180_c100",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if random() > 0.5 else 0"
    }
  },
  "evolution": {
    "rule": "(1 - 0.2)*3.8*c*(1-c) + 0.2*3.8*avg_n*(1-avg_n)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 100
  },
  "id": 51967,
  "postprocess": {
    "effect": "motion_trail"
  }
}