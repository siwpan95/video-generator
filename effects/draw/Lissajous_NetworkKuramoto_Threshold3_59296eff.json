{
  "name": "幻境诗篇",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(3*x*20)*sin(2*y*20) > 0.5) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(sin(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1 if v > 0.66 else (0.5 if v > 0.33 else 0)",
    "green": "1 if v > 0.66 else (0.5 if v > 0.33 else 0)",
    "blue": "1 if v > 0.66 else (0.5 if v > 0.33 else 0)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 22008,
  "postprocess": {
    "effect": "motion_trail"
  }
}