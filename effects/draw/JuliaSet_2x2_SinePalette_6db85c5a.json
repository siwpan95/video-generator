{
  "name": "JuliaSet_2x2_SinePalette_motion_trail_180x180",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x*3-1.5)**2 + (y*3-1.5)**2 < 4) else 0"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and sum_n in [1, 2, 5]) or (c <= 0.5 and sum_n in [3, 6]) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(4*pi*v)",
    "blue": "0.5+0.5*sin(6*pi*v)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 31040,
  "postprocess": {
    "effect": "motion_trail"
  }
}