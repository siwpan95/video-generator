{
  "name": "RadialGradient2_Super_CML_Binary_invert_100x100",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "abs(x-0.5) + abs(y-0.5)"
