{
  "name": "FHN_随机_Lorenz",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "random()"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(c - c**3/3 + avg_n + 0.5)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+pi/3)",
    "blue": "0.5+0.5*cos(2*pi*v)"
  },
  "id": 18
}