{
  "name": "Super_Shape2D_Super_CML_Categorical8_bloom_150x150",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "(((x-p1)/w1)**2 + ((y-p2)/w2)**2 < 1) * 1.0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(int(v*8)/8, 0, 1)",
    "green": "clip(int(v*8 + 4)/8 % 1, 0, 1)",
    "blue": "clip(1 - int(v*8)/8, 0, 1)"
  },
  "cycle": {
    "steps": 1500
  },
  "id": 20030,
  "postprocess": {
    "effect": "bloom"
  }
}