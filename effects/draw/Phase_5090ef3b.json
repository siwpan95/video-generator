{
  "name": "多公式_三init混合_正弦+高斯+Perlin_超级反应_超级色",
  "version": "2.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.33*(0.5+0.5*sin(x*20)*cos(y*20)) + 0.33*exp(-((x-0.5)**2+(y-0.5)**2)/0.04) + 0.34*(0.5+0.5*sin(x*30)*cos(y*30)+0.3*sin(x*60)*cos(y*60))"
    }
  },
  "evolution": {
    "rule": "c + 0.2*(avg_n - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*v)",
    "green": "0.5+0.5*cos(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*cos(2*pi*v+4*pi/3)"
  },
  "id": 102
}