{
  "name": "记忆之旋",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*20)*cos(y*20)"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) + 0.5*c*(1 - c)*(c - 0.3)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v**abs(p1), 0, 1)",
    "green": "clip(v**abs(p2), 0, 1)",
    "blue": "clip(v**abs(p3), 0, 1)"
  },
  "cycle": {
    "steps": 500
  },
  "id": 3198,
  "postprocess": {
    "effect": "motion_trail"
  }
}