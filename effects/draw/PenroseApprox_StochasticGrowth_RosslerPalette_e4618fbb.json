{
  "name": "极光之旋",
  "grid": {
    "width": 80,
    "height": 80,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "(sin(8*pi*x)*sin(8*pi*y) > 0) * 1.0"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if sum_n >= 1 and random() < 0.4 else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "v",
    "green": "0.5+0.5*sin(4*pi*v)",
    "blue": "0.5+0.5*cos(4*pi*v)"
  },
  "cycle": {
    "steps": 1500
  },
  "id": 22297,
  "postprocess": {
    "effect": "invert"
  }
}