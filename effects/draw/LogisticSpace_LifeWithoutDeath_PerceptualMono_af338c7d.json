{
  "name": "梦境初现",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "3.8*x*(1-x)*3.8*y*(1-y)"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if sum_n >= 3 else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v**0.8, 0, 1)",
    "green": "clip(v**0.9, 0, 1)",
    "blue": "clip(v**1.2, 0, 1)"
  },
  "cycle": {
    "steps": 5000
  },
  "id": 32095,
  "postprocess": {
    "effect": "motion_trail"
  }
}