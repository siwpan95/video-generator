{
  "name": "RadialGradient2_Super_CML_Hatch_motion_trail_160x160",
  "grid": {
    "width": 160,
    "height": 160,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "abs(x-0.5) + abs(y-0.5)"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1 if (sin(v*50) > 0) else 0.3",
    "green": "1 if (sin(v*50) > 0) else 0.3",
    "blue": "1 if (sin(v*50) > 0) else 0.3"
  },
  "cycle": {
    "steps": 500
  },
  "id": 30378,
  "postprocess": {
    "effect": "motion_trail"
  }
}