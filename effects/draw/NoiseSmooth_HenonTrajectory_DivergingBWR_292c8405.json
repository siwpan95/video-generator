{
  "name": "NoiseSmooth_HenonTrajectory_DivergingBWR_edge_160x160",
  "grid": {
    "width": 160,
    "height": 160,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*random()"
    }
  },
  "evolution": {
    "rule": "1 - 1.4*c**2 + 0.3*avg_n",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 5000
  },
  "id": 50183,
  "postprocess": {
    "effect": "edge"
  }
}