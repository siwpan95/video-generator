{
  "name": "量子之变",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((int(x*6) + int(y*6)) % 2 == 0) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(-c - avg_n)",
    "variables": [
