    "height": 200,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if random() > 0.9 else 0.1"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.5 and sum_n >= 0.5) else (0 if c > 0.5 else c)",
