{
  "name": "超流体之花",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(complex(x*3-1.5, y*3-1.5)) < 2) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) - 0.01*(c - 0.5)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 0
  },
  "id": 52833
}