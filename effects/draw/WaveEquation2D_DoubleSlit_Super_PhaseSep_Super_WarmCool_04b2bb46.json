{
  "name": "脉动之谜",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "sin(2*pi*10*(x-0.3)) * (exp(-((y-0.3)**2)/0.01) + exp(-((y-0.7)**2)/0.01)) * (abs(x-0.3) < 0.1)"
    }
  },
  "evolution": {
    "rule": "c + f1*(avg_n - c) - f2*(c**3 - w1*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*sin(v*pi*f1+d1)",
    "green": "v",
    "blue": "0.5+0.5*cos(v*pi*f2+d2)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 3000,
  "postprocess": {
    "effect": "bloom"
  }
}