{
  "name": "LogisticSpace_EdenGrowth_DivergingRdBu",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "3.8*x*(1-x)*3.8*y*(1-y)"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if (sum_n >= 0.5 and random() < 0.3) else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip(v*2 if v < 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 1426,
  "postprocess": {
    "effect": "vignette"
  }
}