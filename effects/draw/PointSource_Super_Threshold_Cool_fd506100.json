{
  "name": "漂移之变",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.5)**2 + (y-0.5)**2 < 0.001) else 0.01"
