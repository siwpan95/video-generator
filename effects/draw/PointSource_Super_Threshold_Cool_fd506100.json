      "avg_n"
    ]
  },
  "color": {
    "red": "v",
    "green": "1-v",
    "blue": "1"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 3141,
  "postprocess": {
    "effect": "edge"
  }
}