{
  "name": "相位场_界面传播",
  "version": "1.0",
  "description": "相位场模型模拟界面传播（如结晶、液相转变）。双稳势函数产生清晰的相界面",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(3.1416*(x-0.5)*10)*sin(3.1416*(y-0.5)*10)"
    }
  },
  "neighborhood": {
    "type": "moore",
    "radius": 1
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) + 0.15*c*(1 - c)*(c - 0.5)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "1.0 - v*0.8",
    "green": "0.3 + 0.7*abs(v - 0.5)*2",
    "blue": "0.2 + 0.8*v"
  },
  "tick": {
    "fps": 24,
    "steps_per_frame": 2
  },
  "cycle": {
    "steps": 400
  },
  "id": 136
}