{
  "name": "CrossHair_Lenia_PerceptualLab",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.01 or abs(y-0.5) < 0.01) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(1/(1+exp(-20*(avg_n - 0.15))) - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 3382,
  "postprocess": {
    "effect": "motion_trail"
  }
}