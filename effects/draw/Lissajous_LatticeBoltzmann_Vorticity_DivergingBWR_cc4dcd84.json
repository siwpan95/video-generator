{
  "name": "湍流之光",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(3*x*20)*sin(2*y*20) > 0.5) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) + f1*(avg_n - c)*(sum_n - 4*c)",
    "variables": [
      "c",
      "avg_n",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 22122,
  "postprocess": {
    "effect": "invert"
  }
}