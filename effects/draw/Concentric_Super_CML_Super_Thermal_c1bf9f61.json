{
  "name": "RingSource_Super_CML_Super_Thermal_edge_160x160",
  "grid": {
    "width": 160,
    "height": 160,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(sqrt((x-0.5)**2 + (y-0.5)**2) - 0.3) < 0.02) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*f1, 0, 1)",
    "green": "clip(v*(1-v)*f2*4, 0, 1)",
    "blue": "clip((1-v)*f3, 0, 1)"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 30340,
  "postprocess": {
    "effect": "edge"
  }
}