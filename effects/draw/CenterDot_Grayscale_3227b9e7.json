{
  "name": "DayNight_单点_霓虹",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.03 and abs(y-0.5) < 0.03) else 0 + 0.01*random()"
    }
  },
  "evolution": {
    "rule": "c + 0.2*(avg_n - c)",
    "variables": [
      "c",
      "sum_n",
      "avg_n",
      "x",
      "y",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "v",
    "green": "v",
    "blue": "v"
  },
  "id": 14
}