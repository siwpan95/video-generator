{
  "name": "脉动永恒",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(random()*100)*sin(random()*100)"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5) else (0.5 if sum_n > 1 else c)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "1 if (sin(v*50) > 0) else 0.3",
    "green": "1 if (sin(v*50) > 0) else 0.3",
    "blue": "1 if (sin(v*50) > 0) else 0.3"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 22000,
  "postprocess": {
    "effect": "bloom"
  }
}