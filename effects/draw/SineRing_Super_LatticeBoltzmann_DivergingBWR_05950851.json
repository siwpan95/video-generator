{
  "name": "SineRing_Super_LatticeBoltzmann_DivergingBWR_invert_320x240_c2000",
  "grid": {
    "width": 320,
    "height": 240,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(20*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "c + f1*(avg_n - c) + f2*(avg_n - c)*(sum_n - 4*c)",
    "variables": [
