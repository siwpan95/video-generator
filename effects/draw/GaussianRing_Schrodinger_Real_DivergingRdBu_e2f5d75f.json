{
  "name": "GaussianRing_Schrodinger_Real_DivergingRdBu_none_200x150",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "exp(-((sqrt((x-0.5)**2 + (y-0.5)**2) - 0.3)**2) / 0.01)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - 2*c + avg_n - c) + 0.1*(c**2 + avg_n**2 - 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip(v*2 if v < 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 0
  },
  "id": 50294
}