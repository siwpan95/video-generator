{
  "name": "波函数之光",
  "grid": {
    "width": 512,
    "height": 384,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "abs(x-0.5) + abs(y-0.5)"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if (sum_n >= 0.5 and random() < 0.3) else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*cos(2*pi*v*f1+p1)",
    "green": "0.5+0.5*cos(2*pi*v*f2+p2)",
    "blue": "0.5+0.5*cos(2*pi*v*f3+p3)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 3185,
  "postprocess": {
    "effect": "motion_trail"
  }
}