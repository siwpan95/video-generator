{
  "name": "NoiseFractal_Schrodinger_Real_DivergingBWR_motion_trail_320x240_c1500",
  "grid": {
    "width": 320,
    "height": 240,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*10)*sin(y*10)*sin(x*20)*sin(y*20)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - 2*c + avg_n - c) + 0.1*(c**2 + avg_n**2 - 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 1500
  },
  "id": 52208,
  "postprocess": {
    "effect": "motion_trail"
  }
}