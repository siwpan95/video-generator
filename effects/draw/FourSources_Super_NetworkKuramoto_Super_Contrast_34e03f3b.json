{
  "name": "FourSources_Super_NetworkKuramoto_Super_Contrast_none_200x200",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.25)**2+(y-0.25)**2<0.01 or (x-0.75)**2+(y-0.25)**2<0.01 or (x-0.25)**2+(y-0.75)**2<0.01 or (x-0.75)**2+(y-0.75)**2<0.01) else 0"
    }
  },
  "evolution": {
    "rule": "c + f1*sin(avg_n - c) + f2*sin(2*(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip((v-0.5)*c1+0.5, 0, 1)",
    "green": "clip((v-0.5)*c2+0.5, 0, 1)",
    "blue": "clip((v-0.5)*c3+0.5, 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 30650
}