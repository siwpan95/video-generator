{
  "name": "极光消散_2",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "(cos(f1*atan2(y-p2, x-p1)) > w1) * 1.0"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if (sum_n >= 0.5 and random() < 0.1) else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 52487,
  "postprocess": {
    "effect": "motion_trail"
  }
}