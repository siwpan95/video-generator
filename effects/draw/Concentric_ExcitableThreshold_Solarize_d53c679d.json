{
  "name": "雷暴永恒",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(sqrt((x-0.5)**2 + (y-0.5)**2) - 0.3) < 0.02) else 0 + 0.05*random()"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.98) + 0.01*random()",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "1-v if v > 0.5 else v",
    "green": "1-v if v > 0.5 else v",
    "blue": "1-v if v > 0.5 else v"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 52455,
  "postprocess": {
    "effect": "motion_trail"
  }
}