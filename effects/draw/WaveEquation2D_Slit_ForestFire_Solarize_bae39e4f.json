{
  "name": "WaveEquation2D_Slit_ForestFire_Solarize_edge_200x200",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "sin(2*pi*10*(x-0.3)) * exp(-((y-0.5)**2)/0.01) * (abs(x-0.3) < 0.1) + 0.15*random()"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.5 and sum_n >= 0.5) else (0 if c > 0.5 else c)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "1-v if v > 0.5 else v",
    "green": "1-v if v > 0.5 else v",
    "blue": "1-v if v > 0.5 else v"
  },
  "cycle": {
    "steps": 300
  },
  "id": 30502,
  "postprocess": {
    "effect": "edge"
  }
}