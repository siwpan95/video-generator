{
  "name": "随机_扩散_Jet",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "random()"
    }
  },
  "evolution": {
    "rule": "c + 0.20*(avg_n - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "clip(4*v-1.5, 0, 1)",
    "green": "clip(4*v-0.5, 0, 1)",
    "blue": "clip(-4*v+2.5, 0, 1)"
  },
  "id": 184
}