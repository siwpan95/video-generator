{
  "name": "星云之云_1",
  "grid": {
    "width": 80,
    "height": 80,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*random()"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*cos(2*pi*v), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v), 0, 1)",
    "blue": "clip(1 - v, 0, 1)"
  },
  "cycle": {
    "steps": 3000
  },
  "id": 22037,
  "postprocess": {
    "effect": "bloom"
  }
}