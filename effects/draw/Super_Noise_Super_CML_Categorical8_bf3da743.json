{
  "name": "Super_Noise_Super_CML_Categorical8_400x300",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "clip(w1*random() + p1, 0, 1)"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(int(v*8)/8, 0, 1)",
    "green": "clip(int(v*8 + 4)/8 % 1, 0, 1)",
    "blue": "clip(1 - int(v*8)/8, 0, 1)"
  },
  "cycle": {
    "steps": 100
  },
  "id": 20040
}