{
  "name": "Cateye_DPProcess_SequentialBlues",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.5)**2/0.04 + (y-0.5)**2/0.01 < 1) else 0"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and random() < 0.8) or (c <= 0.5 and sum_n >= 0.5 and random() < 0.4) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "0.2 + 0.8*(1-v)",
    "green": "0.3 + 0.7*(1-v)",
    "blue": "0.5 + 0.5*v"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 1336,
  "postprocess": {
    "effect": "vignette"
  }
}