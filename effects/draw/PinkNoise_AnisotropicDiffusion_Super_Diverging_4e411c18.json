{
  "name": "幻境之云",
  "grid": {
    "width": 160,
    "height": 120,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(random()*100)*sin(random()*100)"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + f1*(v-0.5), 0, 1)",
    "green": "clip(1 - f2*2*abs(v-0.5), 0, 1)",
    "blue": "clip(0.5 - f3*(v-0.5), 0, 1)"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 3234,
  "postprocess": {
    "effect": "bloom"
  }
}