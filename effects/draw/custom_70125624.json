{
  "name": "超级公式_Perlin耦合冷暖",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*1.0*30)*cos(y*1.0*30) + 0.3*sin(x*1.0*60)*cos(y*1.0*60)"
    }
  },
  "evolution": {
    "rule": "(1 - 1.0)*c + 1.0*avg_n + 1.0*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(v*pi*1.0+0.0)",
    "green": "v",
    "blue": "0.5+0.5*cos(v*pi*1.0+0.0)"
  },
  "id": 151
}