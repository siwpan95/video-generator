{
  "name": "漂移之歌",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.02 or abs(y-0.5) < 0.02) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v + 0.2*sin(20*v)",
    "green": "v + 0.1*sin(20*v)",
    "blue": "v - 0.1*sin(20*v)"
  },
  "cycle": {
    "steps": 100
  },
  "id": 31979,
  "postprocess": {
    "effect": "edge"
  }
}