{
  "name": "Percolation50_Super_CML_Super_Perceptual_vignette_180x180",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if random() < 0.5 else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v**abs(p1), 0, 1)",
    "green": "clip(v**abs(p2), 0, 1)",
    "blue": "clip(v**abs(p3), 0, 1)"
  },
  "cycle": {
    "steps": 600
  },
  "id": 30325,
  "postprocess": {
    "effect": "vignette"
  }
}