{
  "name": "Diamond_LatticeBoltzmann_Density_Phase_edge_256x192",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) + abs(y-0.5) < 0.2) else 0"
