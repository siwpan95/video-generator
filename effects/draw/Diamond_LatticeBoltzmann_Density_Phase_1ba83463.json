  "color": {
    "red": "0.5+0.5*cos(2*pi*v)",
    "green": "0.5+0.5*cos(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*cos(2*pi*v+4*pi/3)"
  },
  "cycle": {
    "steps": 5000
  },
  "id": 50123,
  "postprocess": {
    "effect": "edge"
  }
