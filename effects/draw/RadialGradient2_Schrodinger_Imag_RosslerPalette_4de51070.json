  "color": {
    "red": "v",
    "green": "0.5+0.5*sin(4*pi*v)",
    "blue": "0.5+0.5*cos(4*pi*v)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 21893,
  "postprocess": {
    "effect": "invert"
  }
}