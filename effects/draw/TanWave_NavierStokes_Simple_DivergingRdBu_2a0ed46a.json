{
  "name": "TanWave_NavierStokes_Simple_DivergingRdBu_edge_100x100",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*tan(x*10)/(1+abs(tan(x*10)))"
    }
  },
  "evolution": {
    "rule": "c + 0.1*(avg_n - c) - f1*c*(avg_n - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip(v*2 if v < 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 3000
  },
  "id": 30409,
  "postprocess": {
    "effect": "edge"
  }
}