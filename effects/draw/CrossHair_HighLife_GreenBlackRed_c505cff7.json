{
  "name": "炼狱之花",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.01 or abs(y-0.5) < 0.01) else 0"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and sum_n in [2, 3]) or (c <= 0.5 and sum_n in [3, 6]) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "v",
    "green": "0",
    "blue": "1-v"
  },
  "cycle": {
    "steps": 800
  },
  "id": 3001,
  "postprocess": {
    "effect": "bloom"
  }
}