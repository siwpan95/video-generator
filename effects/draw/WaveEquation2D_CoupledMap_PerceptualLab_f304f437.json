{
  "name": "WaveEquation2D_CoupledMap_PerceptualLab",
  "grid": {
    "width": 320,
    "height": 240,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "sin(2*pi*5*sqrt((x-0.5)**2 + (y-0.5)**2)) * exp(-((x-0.5)**2 + (y-0.5)**2)/0.01)"
    }
  },
  "evolution": {
    "rule": "(1 - 0.1)*c + 0.1*avg_n",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 1318,
  "postprocess": {
    "effect": "bloom"
  }
}