{
  "name": "纠缠之歌",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "clip(w1*random() + p1, 0, 1)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*sin(avg_n - c) + 0.001*atan2(sin(avg_n*10), cos(avg_n*10))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+pi/2)",
    "blue": "0.5+0.5*sin(2*pi*v+pi)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 3039,
  "postprocess": {
    "effect": "bloom"
  }
}