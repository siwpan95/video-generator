{
  "name": "角点梯度_Kuramoto_相位",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "abs(x-0.5) * abs(y-0.5)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*sin(avg_n - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*v)",
    "green": "0.5+0.5*cos(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*cos(2*pi*v+4*pi/3)"
  },
  "id": 147
}