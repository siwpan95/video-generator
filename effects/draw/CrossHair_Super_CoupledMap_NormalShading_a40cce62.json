{
  "name": "黑洞之光_1",
  "grid": {
    "width": 240,
    "height": 180,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.01 or abs(y-0.5) < 0.01) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*c + f1*avg_n + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*cos(2*pi*v), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v), 0, 1)",
    "blue": "clip(1 - v, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 32015,
  "postprocess": {
    "effect": "vignette"
  }
}