{
  "name": "潮汐图腾",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (0.2 < (x-0.5)**2 + (y-0.5)**2 < 0.25) else 0"
    }
  },
  "evolution": {
    "rule": "c + f1*(avg_n - 2*c + avg_n) + f2*(c**2 + avg_n**2 - w1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + f1*(v-0.5), 0, 1)",
    "green": "clip(1 - f2*2*abs(v-0.5), 0, 1)",
    "blue": "clip(0.5 - f3*(v-0.5), 0, 1)"
  },
  "cycle": {
    "steps": 100
  },
  "id": 22336,
  "postprocess": {
    "effect": "bloom"
  }
}