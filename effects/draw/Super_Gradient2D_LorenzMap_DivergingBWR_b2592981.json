{
  "name": "Super_Gradient2D_LorenzMap_DivergingBWR_bloom_200x150",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "clip(p1 + w1*abs(x-p2) + w2*abs(y-p3), 0, 1)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(p1*(avg_n - c) - c*avg_n + f1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 500
  },
  "id": 30540,
  "postprocess": {
    "effect": "bloom"
  }
}