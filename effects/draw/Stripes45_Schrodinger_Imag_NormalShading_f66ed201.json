{
  "name": "Stripes45_Schrodinger_Imag_NormalShading_motion_trail_200x150",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin((x+y)*25) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - c) - 0.1*c*(c**2 + avg_n**2 - 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*cos(2*pi*v), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v), 0, 1)",
    "blue": "clip(1 - v, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 31488,
  "postprocess": {
    "effect": "motion_trail"
  }
}