{
  "name": "GaussianRing_Schrodinger_Real_Threshold3_bloom_128x128",
  "grid": {
    "width": 128,
    "height": 128,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "exp(-((sqrt((x-0.5)**2 + (y-0.5)**2) - 0.3)**2) / 0.01)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - 2*c + avg_n - c) + 0.1*(c**2 + avg_n**2 - 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1 if v > 0.66 else (0.5 if v > 0.33 else 0)",
    "green": "1 if v > 0.66 else (0.5 if v > 0.33 else 0)",
    "blue": "1 if v > 0.66 else (0.5 if v > 0.33 else 0)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 50292,
  "postprocess": {
    "effect": "bloom"
  }
}