{
  "name": "涟漪消散",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*tan(x*10)/(1+abs(tan(x*10)))"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(-c - avg_n)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 3151,
  "postprocess": {
    "effect": "edge"
  }
}