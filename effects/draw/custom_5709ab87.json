{
  "name": "超级公式_正弦_反应_超级渐变",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*1.0*20)*cos(y*1.0*20)"
    }
  },
  "evolution": {
    "rule": "c + 1.0*(avg_n - c) + 1.0*sin(c*20)/(1 + 0.5*abs(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "clip(0.0 + 1.0*v, 0, 1)",
    "green": "clip(0.0 + 1.0*v, 0, 1)",
    "blue": "clip(0.0 + 1.0*v, 0, 1)"
  },
  "id": 156
}