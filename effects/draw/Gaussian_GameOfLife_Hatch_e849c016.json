{
  "name": "冰晶之山",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-0.5)**2 + (y-0.5)**2) / 0.04)"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and sum_n >= 2 and sum_n <= 3) or (c <= 0.5 and sum_n == 3) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "1 if (sin(v*50) > 0) else 0.3",
    "green": "1 if (sin(v*50) > 0) else 0.3",
    "blue": "1 if (sin(v*50) > 0) else 0.3"
  },
  "cycle": {
    "steps": 5000
  },
  "id": 22020,
  "postprocess": {
    "effect": "motion_trail"
  }
}