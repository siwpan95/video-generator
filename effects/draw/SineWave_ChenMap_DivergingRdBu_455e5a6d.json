    "height": 200,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*cos(y*20)"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(p1*(avg_n - c) + f1*avg_n)",
