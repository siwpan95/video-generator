{
  "name": "BZSeed_DuffingTrajectory_Super_Perceptual_invert_150x150",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(10*x)*sin(10*y) > 0.5 and random() > 0.5) else 0"
    }
  },
  "evolution": {
