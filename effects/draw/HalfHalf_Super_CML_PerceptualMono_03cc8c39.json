{
  "name": "HalfHalf_Super_CML_PerceptualMono_motion_trail_320x240",
  "grid": {
    "width": 320,
    "height": 240,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if random() > 0.5 else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v**0.8, 0, 1)",
    "green": "clip(v**0.9, 0, 1)",
    "blue": "clip(v**1.2, 0, 1)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 20006,
  "postprocess": {
    "effect": "motion_trail"
  }
}