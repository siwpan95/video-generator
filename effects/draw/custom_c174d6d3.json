{
  "name": "超级公式_正弦场耦合热力",
  "version": "1.0",
  "grid": {
    "width": 300,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*1.0*20)*cos(y*1.0*20)"
    }
  },
  "evolution": {
    "rule": "(1 - 1.0)*c + 1.0*avg_n + 1.0*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "clip(v*1.0, 0, 1)",
    "green": "clip(v*(1-v)*1.0*4, 0, 1)",
    "blue": "clip((1-v)*1.0, 0, 1)"
  },
  "id": 160
}