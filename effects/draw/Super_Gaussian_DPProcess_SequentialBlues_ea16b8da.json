{
  "name": "Super_Gaussian_DPProcess_SequentialBlues",
  "grid": {
    "width": 80,
    "height": 60,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-p1)**2 + (y-p2)**2) / (0.1*(1+w1)))"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and random() < 0.8) or (c <= 0.5 and sum_n >= 0.5 and random() < 0.4) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "0.2 + 0.8*(1-v)",
    "green": "0.3 + 0.7*(1-v)",
    "blue": "0.5 + 0.5*v"
  },
  "cycle": {
    "steps": 400
  },
  "id": 2867,
  "postprocess": {
    "effect": "edge"
  }
}