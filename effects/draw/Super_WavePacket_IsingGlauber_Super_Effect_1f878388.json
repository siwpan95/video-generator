{
  "name": "雷暴瞬间",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-0.5)**2 + (y-0.5)**2)/(0.04+w1))*sin(f1*20*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "1 if (sum_n > 2 and c <= 0.5) or (sum_n < 2 and c > 0.5) else c",
