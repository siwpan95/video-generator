{
  "name": "CenterDot_Super_CML_Posterize_edge_100x100",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.03 and abs(y-0.5) < 0.03) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.25*int(v*4)",
    "green": "0.25*int(v*4)",
    "blue": "0.25*int(v*4)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 30319,
  "postprocess": {
    "effect": "edge"
  }
}