{
  "name": "CenterDot_Super_CML_PerceptualMono_bloom_300x200",
  "grid": {
    "width": 300,
    "height": 200,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.03 and abs(y-0.5) < 0.03) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v**0.8, 0, 1)",
    "green": "clip(v**0.9, 0, 1)",
    "blue": "clip(v**1.2, 0, 1)"
  },
  "cycle": {
    "steps": 800
  },
  "id": 30316,
  "postprocess": {
    "effect": "bloom"
  }
}