{
  "name": "CenterDot_Super_CML_Emboss_edge_320x240",
  "grid": {
    "width": 320,
    "height": 240,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.03 and abs(y-0.5) < 0.03) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v + 0.2*sin(20*v)",
    "green": "v + 0.1*sin(20*v)",
    "blue": "v - 0.1*sin(20*v)"
  },
  "cycle": {
    "steps": 600
  },
  "id": 30312,
  "postprocess": {
    "effect": "edge"
  }
}