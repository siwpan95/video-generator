{
  "name": "涟漪之森",
  "grid": {
    "width": 160,
    "height": 120,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.01 or abs(y-0.5) < 0.01) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v",
    "green": "2*v*(1-v)",
    "blue": "1-v"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 3369,
  "postprocess": {
    "effect": "invert"
  }
}