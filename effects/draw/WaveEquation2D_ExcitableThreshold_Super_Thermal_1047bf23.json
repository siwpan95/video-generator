{
  "name": "WaveEquation2D_ExcitableThreshold_Super_Thermal",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "sin(2*pi*5*sqrt((x-0.5)**2 + (y-0.5)**2)) * exp(-((x-0.5)**2 + (y-0.5)**2)/0.01)"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.95)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v*f1, 0, 1)",
    "green": "clip(v*(1-v)*f2*4, 0, 1)",
    "blue": "clip((1-v)*f3, 0, 1)"
  },
  "cycle": {
    "steps": 800
  },
  "id": 1880
}