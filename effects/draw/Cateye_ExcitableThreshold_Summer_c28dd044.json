  "color": {
    "red": "0.5+0.5*v",
    "green": "0.5+0.25*v",
    "blue": "0.5*v"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 3282,
  "postprocess": {
    "effect": "edge"
  }
}