{
  "name": "Percolation60_ChenMap_DivergingBWR_motion_trail_64x64",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if random() < 0.6 else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(p1*(avg_n - c) + f1*avg_n)",
    "variables": [
      "c",
      "avg_n"
    ]
