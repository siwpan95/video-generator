{
  "name": "费米维度",
  "grid": {
    "width": 160,
    "height": 160,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(x*40) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "0.5*c + 0.5*avg_n + 0.1*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*sin(2*pi*v*0.8), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v*0.8 + 2*pi/3), 0, 1)",
    "blue": "clip(v**0.8, 0, 1)"
  },
  "cycle": {
    "steps": 500
  },
  "id": 52750,
  "postprocess": {
    "effect": "edge"
  }
}