{
  "name": "CircularWave_ExcitableThreshold_Super_Thermal",
  "grid": {
    "width": 300,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(20*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.1 and sum_n > 0.5) else (c * 0.95)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v*f1, 0, 1)",
    "green": "clip(v*(1-v)*f2*4, 0, 1)",
    "blue": "clip((1-v)*f3, 0, 1)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 1464
}