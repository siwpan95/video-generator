{
  "name": "CenterDot_Super_CML_Cool_edge_100x100",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.03 and abs(y-0.5) < 0.03) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v",
    "green": "1-v",
    "blue": "1"
  },
  "cycle": {
    "steps": 500
  },
  "id": 30313,
  "postprocess": {
    "effect": "edge"
  }
}