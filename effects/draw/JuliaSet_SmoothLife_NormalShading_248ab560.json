{
  "name": "JuliaSet2_SmoothLife_NormalShading_motion_trail_150x150",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x*3-1.5)**2 + (y*3-1.5)**2 < 4) else 0"
    }
  },
  "evolution": {
    "rule": "1/(1+exp(-10*(avg_n - 0.3)))",
    "variables": [
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*cos(2*pi*v), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v), 0, 1)",
    "blue": "clip(1 - v, 0, 1)"
  },
  "cycle": {
    "steps": 3000
  },
  "id": 30708,
  "postprocess": {
    "effect": "motion_trail"
  }
}