{
  "name": "Percolation50_Super_CML_RosslerPalette_vignette_300x200",
  "grid": {
    "width": 300,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if random() < 0.5 else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "v",
    "green": "0.5+0.5*sin(4*pi*v)",
    "blue": "0.5+0.5*cos(4*pi*v)"
  },
  "cycle": {
    "steps": 600
  },
  "id": 30322,
  "postprocess": {
    "effect": "vignette"
  }
}