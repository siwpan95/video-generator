{
  "name": "PointSource_SmallWorldSync_Super_Thermal_bloom_300x200",
  "grid": {
    "width": 300,
    "height": 200,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x-0.5)**2 + (y-0.5)**2 < 0.001) else 0.01"
    }
  },
  "evolution": {
    "rule": "c + 0.01*sin(avg_n - c) + 0.001*sin(2*(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*f1, 0, 1)",
    "green": "clip(v*(1-v)*f2*4, 0, 1)",
    "blue": "clip((1-v)*f3, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 20755,
  "postprocess": {
    "effect": "bloom"
  }
}