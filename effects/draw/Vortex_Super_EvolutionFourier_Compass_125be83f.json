{
  "name": "Vortex_Super_EvolutionFourier_Compass",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "atan2(y-0.5, x-0.5) / (2*pi) % 1"
    }
  },
  "evolution": {
    "rule": "c + f1*(avg_n - c) + f2*sin(c*20)/(1 + w1*abs(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+pi/2)",
    "blue": "0.5+0.5*sin(2*pi*v+pi)"
  },
  "cycle": {
    "steps": 500
  },
  "id": 3420,
  "postprocess": {
    "effect": "bloom"
  }
}