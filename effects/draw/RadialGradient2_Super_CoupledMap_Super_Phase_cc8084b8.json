{
  "name": "脉动之梦",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "abs(x-0.5) + abs(y-0.5)"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*c + f1*avg_n + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*cos(2*pi*v*f1+p1)",
    "green": "0.5+0.5*cos(2*pi*v*f2+p2)",
    "blue": "0.5+0.5*cos(2*pi*v*f3+p3)"
  },
  "cycle": {
    "steps": 2000
  },
  "id": 3299,
  "postprocess": {
    "effect": "edge"
  }
}