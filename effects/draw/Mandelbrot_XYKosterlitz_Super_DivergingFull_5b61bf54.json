{
  "name": "共振之森",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(complex(x*3-1.5, y*3-1.5)) < 2) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*sin(avg_n - c) + 0.001*atan2(sin(avg_n*10), cos(avg_n*10))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(f1*(v - 0.5) + 0.5 if v > 0.5 else 0.5 - f2*(0.5 - v), 0, 1)",
    "green": "clip(1 - f3*2*abs(v-0.5), 0, 1)",
    "blue": "clip(f4*(0.5 - v) + 0.5 if v < 0.5 else 0.5 - f5*(v - 0.5), 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 22039,
  "postprocess": {
    "effect": "invert"
  }
}