{
  "name": "进化序曲",
  "grid": {
    "width": 160,
    "height": 160,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x*3-1.5)**2 + (y*3-1.5)**2 < 4) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(-c - avg_n)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 22199,
  "postprocess": {
    "effect": "vignette"
  }
}