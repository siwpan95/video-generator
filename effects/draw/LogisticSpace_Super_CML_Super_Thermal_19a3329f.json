{
  "name": "雷暴之歌",
  "grid": {
    "width": 100,
    "height": 100,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "3.8*x*(1-x)*3.8*y*(1-y)"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*f1, 0, 1)",
    "green": "clip(v*(1-v)*f2*4, 0, 1)",
    "blue": "clip((1-v)*f3, 0, 1)"
  },
  "cycle": {
    "steps": 0
  },
  "id": 3013,
  "postprocess": {
    "effect": "bloom"
  }
}