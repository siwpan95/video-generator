{
  "name": "Grid_Schrodinger_Real_Binary_motion_trail_256x192",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(x*30) * sin(y*30) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - 2*c + avg_n - c) + 0.1*(c**2 + avg_n**2 - 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1 if v > 0.5 else 0",
    "green": "1 if v > 0.5 else 0",
    "blue": "1 if v > 0.5 else 0"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 50303,
  "postprocess": {
    "effect": "motion_trail"
  }
}