{
  "name": "散射弦论",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((atan2(y-0.5, x-0.5) / (2*pi) + sqrt((x-0.5)**2 + (y-0.5)**2) * 2) % 1 < 0.5) else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*cos(2*pi*(v*p1+d1))",
    "green": "0.5+0.5*cos(2*pi*(v*p2+d2))",
    "blue": "0.5+0.5*cos(2*pi*(v*p3+d3))"
  },
  "cycle": {
    "steps": 800
  },
  "id": 52440,
  "postprocess": {
    "effect": "vignette"
  }
}