{
  "name": "虫洞回响",
  "grid": {
    "width": 300,
    "height": 200,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (cos(3*pi*x)*cos(9*pi*x)*cos(27*pi*x) > 0 and cos(3*pi*y)*cos(9*pi*y)*cos(27*pi*y) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "1 if (sum_n > 2 and c <= 0.5) or (sum_n < 2 and c > 0.5) else c",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(v**abs(p1), 0, 1)",
    "green": "clip(v**abs(p2), 0, 1)",
    "blue": "clip(v**abs(p3), 0, 1)"
  },
  "cycle": {
    "steps": 100
  },
  "id": 21705,
  "postprocess": {
    "effect": "invert"
  }
}