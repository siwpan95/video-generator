{
  "name": "TanWave_2x2_Rainbow",
  "grid": {
    "width": 180,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*tan(x*10)/(1+abs(tan(x*10)))"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and sum_n in [1, 2, 5]) or (c <= 0.5 and sum_n in [3, 6]) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*sin(2*pi*v+4*pi/3)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 1765,
  "postprocess": {
    "effect": "edge"
  }
}