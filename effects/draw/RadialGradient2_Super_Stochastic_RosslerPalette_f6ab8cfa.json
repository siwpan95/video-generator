    ]
  },
  "color": {
    "red": "v",
    "green": "0.5+0.5*sin(4*pi*v)",
    "blue": "0.5+0.5*cos(4*pi*v)"
  },
  "cycle": {
    "steps": 600
  },
  "id": 52372,
  "postprocess": {
    "effect": "motion_trail"
  }
}