{
  "name": "中子余辉",
  "grid": {
    "width": 600,
    "height": 400,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "abs(x-0.5) + abs(y-0.5)"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and random() < 0.8) or (c <= 0.5 and sum_n >= 0.5 and random() < 0.4) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*cos(2*pi*(v*p1+d1))",
    "green": "0.5+0.5*cos(2*pi*(v*p2+d2))",
    "blue": "0.5+0.5*cos(2*pi*(v*p3+d3))"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 32187,
  "postprocess": {
    "effect": "edge"
  }
}