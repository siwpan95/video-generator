{
  "name": "反应之谜",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.03 and abs(y-0.5) < 0.03) else 0 + 0.01*random()"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v**0.8, 0, 1)",
    "green": "clip(v**0.9, 0, 1)",
    "blue": "clip(v**1.2, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 31884,
  "postprocess": {
    "effect": "motion_trail"
  }
}