  },
  "color": {
    "red": "0",
    "green": "0.5+0.5*v",
    "blue": "0.5+0.5*v"
  },
  "cycle": {
    "steps": 300
  },
  "id": 3195,
  "postprocess": {
    "effect": "motion_trail"
  }
}