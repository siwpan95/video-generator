{
  "name": "Super_Gaussian_RosslerMap_DivergingBWR",
  "grid": {
    "width": 128,
    "height": 128,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-p1)**2 + (y-p2)**2) / (0.1*(1+w1)))"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(-c - avg_n)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(v*2 if v < 0.5 else 1, 0, 1)",
    "green": "clip((0.5 - abs(v-0.5))*2, 0, 1)",
    "blue": "clip((1-v)*2 if v > 0.5 else 1, 0, 1)"
  },
  "cycle": {
    "steps": 0
  },
  "id": 3544,
  "postprocess": {
    "effect": "invert"
  }
}