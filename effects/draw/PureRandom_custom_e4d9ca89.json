{
  "name": "Kuramoto_耦合振荡",
  "version": "1.0",
  "description": "Kuramoto耦合相位振荡子场。每个格点是一个振荡子，与邻域通过正弦耦合，产生同步波图案",
  "grid": {
    "width": 300,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "random()"
    }
  },
  "neighborhood": {
    "type": "moore",
    "radius": 1
  },
  "evolution": {
    "rule": "(c + 0.12*sin(6.283*(avg_n - c)) + 0.005) % 1.0",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5 + 0.5*sin(v*6.283)",
    "green": "0.5 + 0.5*sin(v*6.283 + 2.094)",
    "blue": "0.5 + 0.5*sin(v*6.283 + 4.189)"
  },
  "tick": {
    "fps": 30,
    "steps_per_frame": 1
  },
  "cycle": {
    "steps": 250
  },
  "id": 36
}