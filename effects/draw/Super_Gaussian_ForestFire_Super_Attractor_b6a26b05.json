    "green": "0.5 + 0.5*sin(2*pi*v*f2 + p2)",
    "blue": "0.5 + 0.5*cos(2*pi*v*f3 + p3)"
  },
  "cycle": {
    "steps": 1200
  },
  "id": 2347,
  "postprocess": {
    "effect": "vignette"
  }
