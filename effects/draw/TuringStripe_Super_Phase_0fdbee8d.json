{
  "name": "Turing_Schnakenberg_超级相位",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(14*x) + 0.3*random()"
    }
  },
  "evolution": {
    "rule": "c + 0.2*(avg_n - c)",
    "variables": [
      "c",
      "sum_n",
      "avg_n",
      "x",
      "y",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*v*f1+p1)",
    "green": "0.5+0.5*cos(2*pi*v*f2+p2)",
    "blue": "0.5+0.5*cos(2*pi*v*f3+p3)"
  },
  "id": 66
}