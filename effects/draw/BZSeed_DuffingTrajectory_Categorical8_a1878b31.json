{
  "name": "BZSeed_DuffingTrajectory_Categorical8_motion_trail_150x150",
  "grid": {
    "width": 150,
    "height": 150,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(10*x)*sin(10*y) > 0.5 and random() > 0.5) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - 0.2*c + c**3) + 0.5*sin(t*0.1)",
    "variables": [
      "c",
      "avg_n",
      "t"
    ]
  },
  "color": {
    "red": "clip(int(v*8)/8, 0, 1)",
    "green": "clip(int(v*8 + 4)/8 % 1, 0, 1)",
    "blue": "clip(1 - int(v*8)/8, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 50656,
  "postprocess": {
    "effect": "motion_trail"
  }
}