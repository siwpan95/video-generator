{
  "name": "JuliaSet2_Super_Stochastic_LorenzPalette_motion_trail_160x160",
  "grid": {
    "width": 160,
    "height": 160,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if ((x*3-1.5)**2 + (y*3-1.5)**2 < 4) else 0"
    }
  },
  "evolution": {
    "rule": "c if c > 0.5 else (1 if (sum_n >= f1 and random() < f2) else 0)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+pi/3)",
    "blue": "0.5+0.5*cos(2*pi*v)"
  },
  "cycle": {
    "steps": 600
  },
  "id": 50848,
  "postprocess": {
    "effect": "motion_trail"
  }
}