{
  "name": "CantorDust_AnisotropicDiffusion_Solarize_invert_64x64",
  "grid": {
    "width": 64,
    "height": 64,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (cos(3*pi*x)*cos(9*pi*x)*cos(27*pi*x) > 0 and cos(3*pi*y)*cos(9*pi*y)*cos(27*pi*y) > 0) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.15*((avg_n - c) if avg_n > c else (c - avg_n))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1-v if v > 0.5 else v",
    "green": "1-v if v > 0.5 else v",
    "blue": "1-v if v > 0.5 else v"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 31529,
  "postprocess": {
    "effect": "invert"
  }
}