{
  "name": "Super_Gradient2D_Super_NetworkKuramoto_Categorical4_motion_trail_200x150",
  "grid": {
    "width": 200,
    "height": 150,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "clip(p1 + w1*abs(x-p2) + w2*abs(y-p3), 0, 1)"
    }
  },
  "evolution": {
    "rule": "c + f1*sin(avg_n - c) + f2*sin(2*(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "1 if v < 0.25 else (0 if v < 0.5 else (1 if v < 0.75 else 0.2))",
    "green": "0.5 if v < 0.25 else (1 if v < 0.5 else (0.5 if v < 0.75 else 0))",
    "blue": "0 if v < 0.25 else (0.5 if v < 0.5 else (1 if v < 0.75 else 1))"
  },
  "cycle": {
    "steps": 800
  },
  "id": 30598,
  "postprocess": {
    "effect": "motion_trail"
  }
}