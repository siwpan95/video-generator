{
  "name": "幻境之山",
  "grid": {
    "width": 128,
    "height": 128,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.02 or abs(y-0.5) < 0.02) else 0"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5) else (0.5 if sum_n > 1 else c)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip((v-0.5)*c1+0.5, 0, 1)",
    "green": "clip((v-0.5)*c2+0.5, 0, 1)",
    "blue": "clip((v-0.5)*c3+0.5, 0, 1)"
  },
  "cycle": {
    "steps": 300
  },
  "id": 3300,
  "postprocess": {
    "effect": "bloom"
  }
}