{
  "name": "Super_Fractal_Super_CML_Super_DivergingFull_bloom_80x80",
  "grid": {
    "width": 80,
    "height": 80,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (sin(f1*pi*x)*sin(f2*pi*x)*sin(f3*pi*x) * sin(f1*pi*y)*sin(f2*pi*y)*sin(f3*pi*y)) > w1 else 0"
    }
  },
  "evolution": {
    "rule": "(1 - f1)*clip(3.8*c*(1-c), 0, 1) + f1*clip(3.8*avg_n*(1-avg_n), 0, 1) + f2*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "red": "clip(f1*(v - 0.5) + 0.5 if v > 0.5 else 0.5 - f2*(0.5 - v), 0, 1)",
    "green": "clip(1 - f3*2*abs(v-0.5), 0, 1)",
    "blue": "clip(f4*(0.5 - v) + 0.5 if v < 0.5 else 0.5 - f5*(v - 0.5), 0, 1)"
  },
  "cycle": {
    "steps": 200
  },
  "id": 20062,
  "postprocess": {
    "effect": "bloom"
  }
}