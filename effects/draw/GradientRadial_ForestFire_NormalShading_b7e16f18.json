{
  "name": "量子序曲",
  "grid": {
    "width": 240,
    "height": 180,
    "wrap": false,
    "initial": {
      "type": "formula",
      "expression": "sqrt((x-0.5)**2 + (y-0.5)**2)"
    }
  },
  "evolution": {
    "rule": "1 if (c <= 0.5 and sum_n >= 0.5) else (0 if c > 0.5 else c)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "red": "clip(0.5 + 0.5*cos(2*pi*v), 0, 1)",
    "green": "clip(0.5 + 0.5*sin(2*pi*v), 0, 1)",
    "blue": "clip(1 - v, 0, 1)"
  },
  "cycle": {
    "steps": 1000
  },
  "id": 31963,
  "postprocess": {
    "effect": "vignette"
  }
}